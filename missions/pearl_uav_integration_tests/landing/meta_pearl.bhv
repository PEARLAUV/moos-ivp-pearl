//-------------------------------------------------
// FILE: meta_pearl.bhv
//-------------------------------------------------

initialize MOOS_MANUAL_OVERRIDE = false
initialize RENDEZVOUS_OWN_ACTIVE           = false
initialize RENDEZVOUS_OWN_WAYPOINT_REACHED = false

// These are initialized for the independent mission's stationkeeping
// behavior; pRendezvous does not save or restore control authority.
initialize DEPLOY       = true
initialize RETURN       = false
initialize STATION_KEEP = false

//----------------------------------------------------
// Circular loiter west of the UAV lane until rendezvous takes over.
// Do not resume after completion/abort: the landing platform must hold still.
Behavior = BHV_Loiter
{
  name      = pearl_loiter
  pwt       = 100
  condition = MOOS_MANUAL_OVERRIDE=false
  condition = RENDEZVOUS_OWN_ACTIVE=false
  condition = (RENDEZVOUS_OWN_PHASE=IDLE) or (RENDEZVOUS_OWN_PHASE=STARTING)

  polygon = format=radial, x=$(PEARL_CENTER_X), y=$(PEARL_CENTER_Y), radius=$(PEARL_RADIUS), pts=12
  clockwise = true
  speed = $(PEARL_SPEED)
  capture_radius = 1
  slip_radius = 2
  acquire_dist = 5

  visual_hints = polygon_label_color=invisible, polygon_vertex_size=0
  visual_hints = polygon_edge_color=dodger_blue, nextpt_label_color=invisible
}

//----------------------------------------------------
// Live-updated rendezvous guidance owned by pRendezvous.
Behavior = BHV_Waypoint
{
  name      = pearl_rendezvous
  pwt       = 110
  perpetual = true
  condition = MOOS_MANUAL_OVERRIDE=false
  condition = RENDEZVOUS_OWN_ACTIVE=true
  updates   = RENDEZVOUS_OWN_UPDATE

  endflag = RENDEZVOUS_OWN_ACTIVE=false
  // The behavior remains active at the point during arrival_dwell;
  // pRendezvous owns local completion.

  speed          = $(PEARL_SPEED)
  capture_radius = 0.8
  slip_radius    = 2
  capture_line   = false
  points         = empty
  repeat         = 0
  order          = normal

  visual_hints = nextpt_color=dodger_blue, nextpt_label_color=invisible
  visual_hints = nextpt_vertex_size=8
  visual_hints = vertex_color=dodger_blue, edge_color=white
}

//----------------------------------------------------
// Hold after rendezvous completes or aborts; never restart the loiter during
// landing or after touchdown.
Behavior = BHV_StationKeep
{
  name      = pearl_hold
  pwt       = 100
  condition = MOOS_MANUAL_OVERRIDE=false
  condition = RENDEZVOUS_OWN_ACTIVE=false
  condition = (RENDEZVOUS_OWN_PHASE=COMPLETE) or (RENDEZVOUS_OWN_PHASE=ABORT)

  center_activate    = true
  inner_radius       = 0.25
  outer_radius       = 0.5
  hibernation_radius = 0.75
  outer_speed        = $(PEARL_SPEED)
  transit_speed      = $(PEARL_SPEED)
  swing_time         = 3

  visual_hints = vertex_size=0, edge_color=magenta, label_color=invisible
}
