//-------------------------------------------------
// FILE: meta_pearl.moos
// PEARL community: simulated surface vehicle, lane transit, rendezvous only.
//-------------------------------------------------

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = pearl

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB             @ NewConsole = false
  Run = pShare             @ NewConsole = false
  Run = pHostInfo          @ NewConsole = false
  Run = pLogger            @ NewConsole = false
  Run = pNodeReporter      @ NewConsole = false
  Run = uFldNodeBroker     @ NewConsole = false
  Run = uFldMessageHandler @ NewConsole = false
  Run = pMediator          @ NewConsole = false
  Run = pRendezvous        @ NewConsole = false
  Run = pHelmIvP           @ NewConsole = false
  Run = uSimMarineV22      @ NewConsole = false
  Run = pMarinePIDV22      @ NewConsole = false
  Run = pThrustMixer       @ NewConsole = false
}

//----------------------------------------------------
// Rendezvous traffic is mediated to the UAV; shoreside observes status via the node broker.
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)

  // Peer-to-peer rendezvous traffic is encapsulated by pMediator.
  output = src_name=MEDIATED_MESSAGE_LOCAL, dest_name=MEDIATED_MESSAGE, route=localhost:$(UAV_PSHARE)
  output = src_name=ACK_MESSAGE_LOCAL, dest_name=ACK_MESSAGE, route=localhost:$(UAV_PSHARE)
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1

  default_hostip_force = localhost
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_PEARL
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = APPCAST
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//----------------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick   = 2
  CommsTick = 2

  platform_type   = ship
  platform_color  = dodger_blue
  platform_length = 2.8
  platform_group  = surface

  cross_fill_policy = global
  report_cog        = true
}

//----------------------------------------------------
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1

  auto_bridge_realmcast = false
  try_shore_host = pshare_route=localhost:$(SHORE_PSHARE)

  bridge = src=NODE_REPORT_LOCAL, alias=NODE_REPORT
  bridge = src=VIEW_POINT
  bridge = src=VIEW_SEGLIST
  bridge = src=VIEW_POLYGON
  bridge = src=VIEW_CIRCLE
  bridge = src=APPCAST

  bridge = src=RENDEZVOUS_OWN_STATE, alias=RENDEZVOUS_PEARL_STATE
  bridge = src=RENDEZVOUS_OWN_PHASE, alias=RENDEZVOUS_PEARL_PHASE
  bridge = src=RENDEZVOUS_OWN_SESSION, alias=RENDEZVOUS_PEARL_SESSION
  bridge = src=RENDEZVOUS_OWN_POINT, alias=RENDEZVOUS_PEARL_POINT
  bridge = src=RENDEZVOUS_OWN_SPEED, alias=RENDEZVOUS_PEARL_SPEED
  bridge = src=RENDEZVOUS_OWN_MOTION, alias=RENDEZVOUS_PEARL_MOTION
}

//----------------------------------------------------
ProcessConfig = uFldMessageHandler
{
  AppTick   = 4
  CommsTick = 4

  strict_addressing = true
}

//----------------------------------------------------
ProcessConfig = pMediator
{
  AppTick   = 4
  CommsTick = 4

  vname         = pearl
  mates         = uav
  resend_thresh = 1
  max_tries     = 10
}

//----------------------------------------------------
// PEARL independently starts on the same shoreside RENDEZVOUS_START flag.
// It exchanges motion history and completes its own waypoint independently.
ProcessConfig = pRendezvous
{
  AppTick   = 4
  CommsTick = 4

  ownship   = pearl
  peer_node = uav

  point_shape        = disc
  point_radius       = 1
  point_color        = dodger_blue
  point_transparency = 0.5
  point_label        = false

  nav_stale_thresh    = 10
  transit_timeout     = 300
  point_freeze_radius = 4
  rendezvous_distance = 1
  arrival_dwell       = 5
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick   = 4
  CommsTick = 4

  ok_skew   = any
  behaviors = targ_pearl.bhv

  park_on_allstop = false
  Domain = course:0:359:360
  Domain = speed:0:0.5:11
}

//----------------------------------------------------
ProcessConfig = uSimMarineV22
{
  AppTick   = 10
  CommsTick = 10

  start_pos = $(PEARL_START)
  prefix    = NAV

  max_speed        = 1
  max_deceleration = 0.5
  turn_rate        = 100
  turn_spd_loss    = 0.6
  thrust_mode_diff = true

  post_des_thrust = DESIRED_THRUSTX
  post_des_rudder = DESIRED_RUDDERX
}

//----------------------------------------------------
ProcessConfig = pMarinePIDV22
{
  AppTick   = 10
  CommsTick = 10

  verbose       = false
  depth_control = false
  active_start  = true

  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.1
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder    = 100
  maxthrust    = 100
  speed_factor = 20
}

//----------------------------------------------------
ProcessConfig = pThrustMixer
{
  AppTick   = 10
  CommsTick = 10

  input_thrust_var = DESIRED_THRUST
  input_rudder_var = DESIRED_RUDDER
  output_left_var  = DESIRED_THRUST_L
  output_right_var = DESIRED_THRUST_R
  state_var        = THRUST_MIXER_STATE

  max_thrust    = 100
  max_rudder    = 50
  stale_timeout = 1
}
