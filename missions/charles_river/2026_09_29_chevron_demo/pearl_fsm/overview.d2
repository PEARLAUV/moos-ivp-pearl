      class: [transition; moos_transition; moos_var_PEARL_FSM_RECOVERY_SUPPORT_TRANSITION; moos_id_POST_INTERRUPTION_CHECKS_FAILED]
      style: {
        stroke: "#12344D"
      }
    }
    supporting_approach -> supporting_landing: "Drone landing" {
      class: [transition; moos_transition; moos_var_PEARL_FSM_RECOVERY_SUPPORT_TRANSITION; moos_id_SUPPORTING_APPROACH_TO_SUPPORTING_LANDING]
      style: {
        stroke: "#12344D"
      }
    }
    supporting_approach -> disengaging_recovery_support: "Recovery support\ncancellation requested" {
      class: [transition; moos_transition; moos_var_PEARL_FSM_RECOVERY_SUPPORT_TRANSITION; moos_id_SUPPORTING_APPROACH_TO_DISENGAGING_RECOVERY_SUPPORT]
      style: {
        stroke: "#12344D"
      }
    }
    supporting_landing -> confirming_recovery: "Drone touchdown" {
      class: [transition; moos_transition; moos_var_PEARL_FSM_RECOVERY_SUPPORT_TRANSITION; moos_id_SUPPORTING_LANDING_TO_CONFIRMING_RECOVERY]
      style: {
        stroke: "#12344D"
      }
    }
    supporting_landing -> disengaging_recovery_support: "Recovery support\ncancellation requested" {
      class: [transition; moos_transition; moos_var_PEARL_FSM_RECOVERY_SUPPORT_TRANSITION; moos_id_SUPPORTING_LANDING_TO_DISENGAGING_RECOVERY_SUPPORT]
      style: {
        stroke: "#12344D"
      }
    }
    confirming_recovery -> sink: "Recovery confirmed" {
      class: [transition; sink_transition]
      style: {
        stroke: "#12344D"
      }
    }
    cancelling_before_clearance -> sink: "Recovery\ncancellation\ncomplete" {
      class: [transition; sink_transition]
      style: {
        stroke: "#12344D"
      }
    }
    disengaging_recovery_support -> sink: "Recovery\nsupport\ndisengaged" {
      class: [transition; sink_transition]
      style: {
        stroke: "#12344D"
      }
    }
  }
}
