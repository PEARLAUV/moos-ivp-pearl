}

//----------------------------------------------------
// Draw a fixed-orientation square centered on PEARL once per second while the
// takeoff-support stationkeep is active. A 4.24264 m circumradius and four
// vertices give a 6 m x 6 m square; this does not affect the helm's radii.
ProcessConfig = uTakeoffSquareDraw
{
  AppTick    = 4
  CommsTick  = 4
  paused     = false
  verbose    = false
  reset_time = all-posted
  reset_max  = no_limit
  upon_awake = reset
  status_var = TAKEOFF_SQUARE_DRAW_STATUS
  condition  = PEARL_TAKEOFF_STATIONKEEP_ACTIVE = true

  event = var=VIEW_POLYGON, val="radial:: x=$(NAV_X),y=$(NAV_Y),radius=4.242640687,pts=4,label=$(VNAME):takeoff-support,vertex_size=0,edge_color=red,edge_size=2", time=1
}

// Clear the same viewer polygon when the behavior becomes inactive. Reposting
// also clears any stale hint after the script or viewer restarts.
ProcessConfig = uTakeoffSquareErase
{
  AppTick    = 4
  CommsTick  = 4
  paused     = false
  verbose    = false
  reset_time = all-posted
  reset_max  = no_limit
  upon_awake = reset
  status_var = TAKEOFF_SQUARE_ERASE_STATUS
  condition  = PEARL_TAKEOFF_STATIONKEEP_ACTIVE = false

  event = var=VIEW_POLYGON, val="radial:: x=$(NAV_X),y=$(NAV_Y),radius=4.242640687,pts=4,label=$(VNAME):takeoff-support,active=false", time=1
}

//----------------------------------------------------
// Grants only when every session-matched uChecks aggregate succeeds. A failed
// check denies immediately; pending/missing results are bounded by timeout.
ProcessConfig = pTakeoffProcessor
{
  AppTick = 4
  CommsTick = 4
  term_report_interval = 2
  ownship = $(VNAME)
  requester = uav

  receipt_var = TAKEOFF_REQUEST_ID
  // Local PEARL FSM acknowledgement; never sent as a UAV message.
  status_var = TAKEOFF_REQUEST_STATE
  // Flight progress is ID-tagged and does not overwrite the granted guard.
  progress_var = UAV_TAKEOFF_PROGRESS
  progress_grace = 120

  checks_result_var = TAKEOFF_PRECHECKS_STATE
  checks_result_var = TAKEOFF_POSTCHECKS_STATE

  release_condition = PEARL_FSM_OPERATION_STATE=NORMAL_OPERATION

  timeout = 100
}

//----------------------------------------------------
// PEARL is the rendezvous coordinator: it selects the point, waits for an
// explicit UAV acceptance, moves both vehicles, and grants landing clearance.
ProcessConfig = pRendezvous
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  role      = pearl
  ownship   = $(VNAME)
  peer_node = uav

  uav_speed       = 3
  pearl_speed     = $(SPEED)
  min_battery     = 25
  critical_battery = 15
  battery_max_age = 3
  require_battery = true
  require_health  = false
  require_flight_state = false

  nav_stale_thresh = 10
  request_timeout  = 100
  transit_timeout  = 180
  arrival_radius   = 1.5
  arrival_dwell    = 2
  max_peer_separation = 3
  require_platform_ready  = false
  require_platform_health = true
  min_pearl_battery        = 15
  max_landing_wind_speed   = 4
  platform_data_max_age    = 3
  landing_target_acquire_timeout = 30
}


