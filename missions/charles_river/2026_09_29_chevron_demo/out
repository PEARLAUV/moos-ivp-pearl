//----------------------------------------------------
// One session-scoped collection owns PEARL's takeoff precheck result.
ProcessConfig = uChecksTakeoff
{
  AppTick = 4
  CommsTick = 4
  // Continue checking throughout bay opening and post-interruption checks;
  // stop before awaiting departure. The request ID scopes each check run.
  condition = ((PEARL_FSM_SUPPORT_ACTIVITY_STATE=TAKEOFF_PRE_INTERRUPTION_CHECKS) or (PEARL_FSM_TAKEOFF_SUPPORT_STATE=ESTABLISHING_TAKEOFF_CONDITIONS)) or (PEARL_FSM_TAKEOFF_SUPPORT_STATE=POST_INTERRUPTION_CHECKS)
  session_var = TAKEOFF_REQUEST_ID
  result_var = TAKEOFF_PRECHECKS_STATE
  result_prefix = TAKEOFF_CHECK_

  // GPS_QUALITY is an NMEA GGA string and publishes only on change. Pair it
  // with fresh GGA latitude/longitude from the same GPS source.
  check = name=GPS_FIX,timeout=60
  require = check=GPS_FIX,var=GPS_QUALITY,type=string,one_of=1|2|4|5,on_mismatch=fail
  check = name=GPS_STREAM,timeout=10,max_age=3
  require = check=GPS_STREAM,var=GPS_LATITUDE,type=double,min=-90,max=90,on_mismatch=wait
  require = check=GPS_STREAM,var=GPS_LONGITUDE,type=double,min=-180,max=180,on_mismatch=wait

  check = name=BATTERY,timeout=5,max_age=3
  require = check=BATTERY,var=PEARL_BATTERY_DATA_VALID,type=double,equals=1,on_mismatch=fail
  require = check=BATTERY,var=PEARL_BATTERY_SOC,type=double,min=15,on_mismatch=fail
  require = check=BATTERY,var=PEARL_BATTERY_DATA_AGE,type=double,min=0,max=3,on_mismatch=wait

  check = name=WIND,timeout=5,max_age=3
  require = check=WIND,var=PEARL_WIND_DATA_VALID,type=double,equals=1,on_mismatch=fail
  require = check=WIND,var=PEARL_WIND_SPEED,type=double,min=0,max=4,on_mismatch=fail
  require = check=WIND,var=PEARL_AIRMAR_DATA_AGE,type=double,min=0,max=3,on_mismatch=wait
}

//----------------------------------------------------
// The post-interruption collection separately confirms the cover is open.
// Keep it active while awaiting departure so a close is observable.
ProcessConfig = uChecksPostInterruption
{
  AppTick = 4
  CommsTick = 4
  condition = (PEARL_FSM_TAKEOFF_SUPPORT_STATE=POST_INTERRUPTION_CHECKS) or (PEARL_FSM_TAKEOFF_SUPPORT_STATE=AWAITING_DRONE_DEPARTURE)
  session_var = TAKEOFF_REQUEST_ID
  result_var = TAKEOFF_POSTCHECKS_STATE
  result_prefix = TAKEOFF_POSTCHECK_

  // The cover event is posted once. No input-age lease is appropriate.
  check = name=DRONEPORT_BAY,timeout=20
  require = check=DRONEPORT_BAY,var=PEARL_DRONEPORT_BAY_COVER_STATE,type=string,equals=open,on_mismatch=fail
}

//----------------------------------------------------
// The demo has no physical droneport cover; this timed mock runs in both
// SIM and REAL until a cover actuator/telemetry publisher is installed.
ProcessConfig = uSimDroneportBayCover
{
  AppTick = 10
  CommsTick = 10
  condition = PEARL_FSM_TAKEOFF_SUPPORT_STATE=ESTABLISHING_TAKEOFF_CONDITIONS
  upon_awake = restart
  script_atomic = false
  reset_max = unlimited
  paused = false
  script_name = SIM_DRONEPORT_BAY_COVER

  event = var=PEARL_DRONEPORT_BAY_COVER_STATE, val=opening, time=0
  event = var=PEARL_DRONEPORT_BAY_COVER_STATE, val=open,    time=10
}

