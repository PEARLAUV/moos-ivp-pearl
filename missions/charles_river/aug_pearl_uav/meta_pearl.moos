//-------------------------------------------------
// FILE: meta_pearl.moos
// NAME: Charles Benjamin
//-------------------------------------------------

// All PEARL processes connect to the local MOOSDB. IP_ADDR is used only as
// the community's externally advertised pShare identity.
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB             @ NewConsole = false
  Run = pRealm             @ NewConsole = false
  Run = uProcessWatch      @ NewConsole = false
  Run = uLoadWatch         @ NewConsole = false
  Run = pShare             @ NewConsole = false
  Run = pHostInfo          @ NewConsole = false
  Run = pLogger            @ NewConsole = false
  Run = pEchoVar           @ NewConsole = false
  Run = pNodeReporter      @ NewConsole = false
  Run = uFldNodeBroker     @ NewConsole = false
  Run = uFldMessageHandler @ NewConsole = false
  Run = pMediator          @ NewConsole = false
  Run = pRendezvous        @ NewConsole = false
  Run = pHelmIvP           @ NewConsole = false

#ifdef XMODE REAL
  Run = iDualGPS           @ NewConsole = false
  Run = iPEARL             @ NewConsole = false
  Run = pPearlPID          @ NewConsole = false
  Run = iBlueRoboticsPing  @ NewConsole = false
  Run = iSherlockTelemetry @ NewConsole = false
#else
  Run = uTimerScript     @ NewConsole = false ~ uSimTakeoffInputs
  Run = uSimMarineV22      @ NewConsole = false
  Run = pMarinePIDV22      @ NewConsole = false
  Run = pThrustMixer       @ NewConsole = false
#endif
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)
#ifdef DIRECT_PEER true
  output = src_name=MEDIATED_MESSAGE_LOCAL, dest_name=MEDIATED_MESSAGE, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=ACK_MESSAGE_LOCAL, dest_name=ACK_MESSAGE, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=PEARL_BATTERY_SOC, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=PEARL_BATTERY_DATA_VALID, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=PEARL_WIND_SPEED, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=PEARL_WIND_DATA_VALID, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=PROC_WATCH_ALL_OK, dest_name=PEARL_PROC_WATCH_ALL_OK, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=NODE_REPORT_LOCAL, dest_name=NODE_REPORT, route=$(UAV_IP):$(UAV_PSHARE)
#ifdef XMODE SIM
#ifdef SIM_ATTACHMENT true
  output = src_name=NAV_X,       dest_name=ATTACHMENT_NAV_X,       route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=NAV_Y,       dest_name=ATTACHMENT_NAV_Y,       route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=NAV_HEADING, dest_name=ATTACHMENT_NAV_HEADING, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=NAV_SPEED,   dest_name=ATTACHMENT_NAV_SPEED,   route=$(UAV_IP):$(UAV_PSHARE)
#endif
#endif
#endif
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  default_hostip_force = $(IP_ADDR=localhost)
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

#ifdef XMODE REAL
  thresh = app=iDualGPS,       gapthresh=3
  thresh = app=iPEARL,         gapthresh=3
  thresh = app=pPearlPID,      gapthresh=3
  thresh = app=iSherlockTelemetry, gapthresh=8
#else
  thresh = app=uSimTakeoffInputs, gapthresh=3
  thresh = app=uSimMarineV22,  gapthresh=3
  thresh = app=pMarinePIDV22,  gapthresh=3
  thresh = app=pThrustMixer,   gapthresh=3
#endif
  thresh = app=pHelmIvP,       gapthresh=3
  thresh = app=pNodeReporter,  gapthresh=4
  thresh = app=pHostInfo,      gapthresh=5
  thresh = app=any,            gapthresh=2.0

  breach_trigger = 5
}

//----------------------------------------------------
#ifdef XMODE REAL
#else
ProcessConfig = uSimTakeoffInputs
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  paused     = false
  reset_max  = unlimited
  reset_time = 1
  script_name = SIM_TAKEOFF_INPUTS

  event = var=PEARL_BATTERY_SOC,        val=80,   time=0
  event = var=PEARL_BATTERY_DATA_VALID, val=true, time=0
  event = var=PEARL_WIND_SPEED,         val=2,    time=0
  event = var=PEARL_WIND_DATA_VALID,    val=true, time=0
}
#endif

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_$(VNAME)
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = APPCAST
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardOmitPattern = PHI_HOST*
  WildCardOmitPattern = NAV_PITCH
  WildCardOmitPattern = NAV_YAW
  WildCardOmitPattern = NAV_Z
}

//----------------------------------------------------
ProcessConfig = pMediator
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  vname         = $(VNAME)
  mates         = uav
  resend_thresh = 1
  max_tries     = 10
}

//----------------------------------------------------
// PEARL is the rendezvous coordinator: it selects the point, waits for an
// explicit UAV acceptance, moves both vehicles, and grants landing clearance.
ProcessConfig = pRendezvous
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  role      = pearl
  ownship   = $(VNAME)
  peer_node = uav

  uav_speed       = 3
  pearl_speed     = $(SPEED)
  min_battery     = 25
  critical_battery = 15
  battery_max_age = 3
  require_battery = true
  require_health  = false
  require_flight_state = false

  nav_stale_thresh = 10
  request_timeout  = 20
  transit_timeout  = 180
  arrival_radius   = 5
  arrival_dwell    = 2
  max_peer_separation = 3
#ifdef XMODE REAL
  require_platform_ready  = true
#else
  require_platform_ready  = false
#endif
  require_platform_health = true
  min_pearl_battery        = 15
  max_landing_wind_speed   = 4
  platform_data_max_age    = 3
  landing_target_acquire_timeout = 30
}

//----------------------------------------------------
// Translate PEARL's sensors into the standard NAV variables and keep PEARL's
// operator controls namespaced away from the UAV.
ProcessConfig = pEchoVar
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  Echo = GPS_LATITUDE     -> NAV_LAT
  Echo = GPS_LONGITUDE    -> NAV_LONG
  Echo = GPS_X            -> NAV_X
  Echo = GPS_Y            -> NAV_Y
  Echo = GPS_HEADING_GPRMC -> NAV_HEADING
  Echo = IMU_PITCH        -> NAV_PITCH
  Echo = IMU_ROLL         -> NAV_ROLL
  Echo = GPS_SPEED        -> NAV_SPEED

  Echo = PEARL_DEPLOY          -> DEPLOY
  Echo = PEARL_RETURN          -> RETURN
  Echo = PEARL_STATION_KEEP    -> STATION_KEEP
  Echo = PEARL_MANUAL_OVERRIDE -> MOOS_MANUAL_OVERRIDE
}

//----------------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick   = 2
  CommsTick = 2
  term_report_interval = 2

  platform_type   = ship
  platform_color  = $(COLOR)
  platform_length = 2.8
  platform_group  = surface

  cross_fill_policy = global
  report_cog        = true
}

//----------------------------------------------------
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  auto_bridge_realmcast = false
  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

  bridge = src=NODE_REPORT_LOCAL, alias=NODE_REPORT
  bridge = src=MEDIATED_MESSAGE_LOCAL, alias=MEDIATED_MESSAGE
  bridge = src=ACK_MESSAGE_LOCAL, alias=ACK_MESSAGE
  bridge = src=VIEW_POLYGON
  bridge = src=VIEW_POINT
  bridge = src=VIEW_SEGLIST
  bridge = src=VIEW_CIRCLE
  bridge = src=APPCAST
  bridge = src=IVPHELM_STATE
  bridge = src=PROC_WATCH_ALL_OK, alias=PEARL_PROC_WATCH_ALL_OK
  bridge = src=PEARL_RENDEZVOUS_STATE
  bridge = src=PEARL_RENDEZVOUS_PHASE
  bridge = src=PEARL_RENDEZVOUS_SESSION
  bridge = src=PEARL_LANDING_GATE_READY
  bridge = src=PEARL_LANDING_GATE_REASON
  bridge = src=PEARL_UAV_SEPARATION
  bridge = src=RENDEZVOUS_POINT
  bridge = src=PEARL_BATTERY_SOC
  bridge = src=PEARL_BATTERY_CHARGING
  bridge = src=PEARL_BATTERY_DATA_VALID
  bridge = src=PEARL_BATTERY_DATA_AGE
  bridge = src=PEARL_WIND_SPEED
  bridge = src=PEARL_WIND_DATA_VALID
  bridge = src=PEARL_AIRMAR_DATA_AGE
  bridge = src=ALFA_LINK_UP
  bridge = src=ALFA_STATION_COUNT
  bridge = src=ALFA_SIGNAL_DBM
  bridge = src=ALFA_SIGNAL_AVG_DBM
  bridge = src=ALFA_TX_BITRATE_MBPS
  bridge = src=ALFA_RX_BITRATE_MBPS
  bridge = src=ALFA_TX_RETRIES_TOTAL
  bridge = src=ALFA_TX_FAILED_TOTAL
  bridge = src=ALFA_INACTIVE_MS
  bridge = src=ALFA_DATA_VALID
  bridge = src=ALFA_DATA_AGE
  bridge = src=ALFA_SIGNAL_DATA_VALID
}

//----------------------------------------------------
ProcessConfig = uFldMessageHandler
{
  AppTick   = 3
  CommsTick = 3
  term_report_interval = 2

  strict_addressing = true
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  ok_skew   = any
  behaviors = targ_$(VNAME).bhv
  Domain    = course:0:359:360
  Domain    = speed:0:0.5:11
}

#ifdef XMODE REAL
//----------------------------------------------------
// PEARL hardware configuration retained from may_test_run.
ProcessConfig = iDualGPS
{
  AppTick   = 10
  CommsTick = 10

  DUAL_GPS = false
  PORT_1   = /dev/ttyAMA5   // Port GPS
  BAUDRATE = 9600
  PREFIX   = GPS

  HEADING_OFFSET = 0.0
  PUBLISH_RAW     = true
  PUBLISH_HDOP    = true
  TRIGGER_MSG     = GNGGA
}

//----------------------------------------------------
ProcessConfig = iPEARL
{
  AppTick   = 10
  CommsTick = 10

  PORT           = /dev/ttyACM0
  BAUDRATE       = 115200
  PREFIX         = IMU
  HEADING_OFFSET = 0.0

  LEFT_MOTOR_FRAC  = 1.0
  RIGHT_MOTOR_FRAC = 1.0
}

//----------------------------------------------------
ProcessConfig = pPearlPID
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  VERBOSE       = true
  DEPTH_CONTROL = false
  ACTIVE_START  = true

  SUN_TRACKING                = false
  HEADING_DEADBAND            = 5
  HOLONOMIC_TURN              = true
  HOLONOMIC_TURN_ON_ERROR     = 30
  HOLONOMIC_TURN_OFF_ERROR    = 10
  HOLONOMIC_TURN_MAX_SPEED = 0.06 // m/s; only pivot-turn when nearly stopped
  YAW_PID_KP                  = 0.25
  YAW_PID_KI                  = 0.00
  YAW_PID_KD                  = 2
  YAW_PID_INTEGRAL_LIMIT      = 0.00
  SPEED_PID_KP                = 1.0
  SPEED_PID_KD                = 0.0
  SPEED_PID_KI                = 0.0
  SPEED_PID_INTEGRAL_LIMIT    = 0.07
  SPEED_FACTOR                = 0
}

//----------------------------------------------------
ProcessConfig = iBlueRoboticsPing
{
  AppTick   = 4
  CommsTick = 4
}

//----------------------------------------------------
ProcessConfig = iSherlockTelemetry
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  metrics_host    = $(SHERLOCK_METRICS_HOST)
  metrics_port    = $(SHERLOCK_METRICS_PORT)
  metrics_path    = /metrics
  poll_interval   = 2
  http_timeout    = 1
  battery_max_age = 30
  airmar_max_age  = 5
  alfa_max_age    = 10
}
#else
//----------------------------------------------------
ProcessConfig = uSimMarineV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  start_pos = $(START_POS)
  prefix    = NAV

  max_speed        = 1
  max_deceleration = 0.5
  turn_rate        = 100
  turn_spd_loss    = 0.6

  // PEARL is a differential-drive vehicle. Opposed motor commands allow
  // rotation in place instead of the normal rudder model's wide turns.
  thrust_mode_diff = true

  post_des_thrust = DESIRED_THRUSTX
  post_des_rudder = DESIRED_RUDDERX
}

//----------------------------------------------------
ProcessConfig = pMarinePIDV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  verbose       = false
  depth_control = false
  active_start  = true

  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.1
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder   = 100
  maxthrust   = 100
  speed_factor = 20
}

//----------------------------------------------------
ProcessConfig = pThrustMixer
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  input_thrust_var = DESIRED_THRUST
  input_rudder_var = DESIRED_RUDDER
  output_left_var  = DESIRED_THRUST_L
  output_right_var = DESIRED_THRUST_R
  state_var        = THRUST_MIXER_STATE

  // Match the limits used by iPEARL's real thrust/rudder mixer.
  max_thrust    = 100
  max_rudder    = 50
  stale_timeout = 1
}
#endif
