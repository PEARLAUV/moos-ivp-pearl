//-------------------------------------------------
// FILE: meta_pearl.bhv
// NAME: Charles Benjamin
//-------------------------------------------------

initialize MOOS_MANUAL_OVERRIDE = false
initialize PEARL_ALLSTOP        = false
initialize MAIN_TASK_STATUS         = none
initialize RENDEZVOUS_OWN_ACTIVE  = false
initialize RENDEZVOUS_OWN_WAYPOINT_REACHED = false
initialize PEARL_TAKEOFF_STATIONKEEP_ACTIVE = false
initialize ROUTE_READY = false
initialize ROUTE_DEPLOY = false
initialize ROUTE_CLEAR = false

//----------------------------------------------------
Behavior = BHV_StationKeep
{
  name      = pearl_station_keep
  pwt       = 100
  // Retain autonomous station-keeping while ALLSTOP suspends the FSM.
  condition = (PEARL_FSM_MAIN_ACTIVITY_STATE=IDLE) or (PEARL_ALLSTOP=true)
  condition = MOOS_MANUAL_OVERRIDE=false

  // Hold tightly enough for the UAV's three-metre landing-separation gate.
  center_activate    = true
  inner_radius       = 0.25
  outer_radius       = 0.5
  hibernation_radius = 0.75
  outer_speed        = $(SPEED)
  transit_speed      = $(SPEED)
  swing_time         = 3

  visual_hints = vertex_size=0, edge_color=blue, label_color=invisible, nextpt_label_color=invisible
}

//----------------------------------------------------
// Independent station-keeping during takeoff support, with a distinct display.
Behavior = BHV_StationKeep
{
  name         = pearl_takeoff_station_keep
  pwt          = 100
  condition    = PEARL_FSM_OPERATION_STATE=TAKEOFF_SUPPORT
  activeflag   = PEARL_TAKEOFF_STATIONKEEP_ACTIVE=true
  inactiveflag = PEARL_TAKEOFF_STATIONKEEP_ACTIVE=false

  center_activate    = true
  inner_radius       = 0.25
  outer_radius       = 0.5
  hibernation_radius = 0.75
  outer_speed        = $(SPEED)
  transit_speed      = $(SPEED)
  swing_time         = 3

  visual_hints = vertex_size=0, edge_color=red, edge_size=2, label_color=invisible, nextpt_label_color=invisible
}

//----------------------------------------------------
Behavior = BHV_Waypoint
{
  templating = spawn
  name = pearl_main_task_
  pwt = 100
  updates = ROUTE_UPDATE
  spawnflag = ROUTE_READY=true
  spawnflag = ROUTE_READY_NAME=$[BHVNAME]
  spawnflag = ROUTE_CLEAR=false
  // Parent suspension preserves the current waypoint index for history resume.
  condition = (ROUTE_CLEAR=true) or (PEARL_FSM_OPERATION_STATE=NORMAL_OPERATION)
  condition = (ROUTE_CLEAR=true) or (PEARL_FSM_MAIN_ACTIVITY_STATE=EXECUTING_MISSION)
  condition = (ROUTE_CLEAR=true) or (RENDEZVOUS_OWN_ACTIVE=false)
  condition = (ROUTE_CLEAR=true) or (ROUTE_DEPLOY=true)
  endflag = MAIN_TASK_STATUS=completed
  endflag = ROUTE_READY=false
  endflag = ROUTE_READY_NAME=none
  endflag = ROUTE_DEPLOY=false
  endflag = ROUTE_CLEAR=false
  speed = $(SPEED)
  capture_radius = 1
  slip_radius = 2
  order = normal
  repeat = 0
  points = empty
  visual_hints = label_color=invisible, nextpt_label_color=invisible
  visual_hints = edge_color=dodger_blue, vertex_color=dodger_blue
}

//----------------------------------------------------
Behavior = BHV_Waypoint
{
  name      = pearl_return
  pwt       = 100
  condition = PEARL_FSM_MAIN_ACTIVITY_STATE=RETURNING_TO_BASE
  endflag   = MAIN_TASK_STATUS=returned
  perpetual = true

  speed          = $(SPEED)
  capture_radius = 2
  slip_radius    = 8
  points         = 10.6,4.8
}

//----------------------------------------------------
// Hold after capturing the local point, even before the vehicles are close.
Behavior = BHV_StationKeep
{
  name      = pearl_recovery_station_keep
  pwt       = 100
  condition = PEARL_FSM_OPERATION_STATE=RECOVERY_SUPPORT
  condition = RENDEZVOUS_OWN_ACTIVE=false
  condition = MOOS_MANUAL_OVERRIDE=false

  center_activate    = true
  inner_radius       = 0.25
  outer_radius       = 0.5
  hibernation_radius = 0.75
  outer_speed        = $(SPEED)
  transit_speed      = $(SPEED)
  swing_time         = 3
  visual_hints = vertex_size=0, edge_color=magenta, label_color=invisible, nextpt_label_color=invisible
}

//----------------------------------------------------
// A dedicated waypoint instance prevents rendezvous updates from changing
// PEARL's fixed route. Its capture radius is independent of point freezing
// and vehicle-to-vehicle arrival distance.
Behavior = BHV_Waypoint
{
  name       = pearl_rendezvous
  pwt        = 110
  perpetual  = true
  condition = MOOS_MANUAL_OVERRIDE=false
  condition = RENDEZVOUS_OWN_ACTIVE=true
  updates   = RENDEZVOUS_OWN_UPDATE

  endflag = RENDEZVOUS_OWN_ACTIVE=false
  // Capturing a waypoint is NOT rendezvous arrival; pRendezvous owns that.
  endflag = RENDEZVOUS_OWN_WAYPOINT_REACHED=true
  endflag = RETURN=false
  endflag = STATION_KEEP=true

  speed          = $(SPEED)
  capture_radius = 1
  // Disable non-monotonic/slip completion for this one-point maneuver.
  // When PEARL starts close but is still moving away, a larger slip radius
  // can otherwise declare success before she has actually reached the point.
  slip_radius    = 1
  capture_line   = false
  points         = empty
  repeat         = 0
  order          = normal

  visual_hints = nextpt_color=magenta, label_color=invisible, nextpt_label_color=invisible
  visual_hints = nextpt_vertex_size=8
  visual_hints = vertex_color=magenta, edge_color=white, label_color=invisible, nextpt_label_color=invisible
}
