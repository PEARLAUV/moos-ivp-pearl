# ArduCopter SITL parameters for the default Charles River rendezvous.
# The moving target is supplied over MAVLink by pMavlinkShipBridge.
PLND_ENABLED      1
PLND_TYPE         1
PLND_OPTIONS      1
PLND_STRICT       2
SIM_PLD_ENABLE    0

# PEARL publishes system 17 GLOBAL_POSITION_INT through SERIAL2. The external
# ship mode consumes that pose while ArduPilot remains authoritative for
# landed-aircraft position/height forcing and takeoff detachment. MOOS owns
# coupling intent through SIM_UAV_ON_SHIP; no external-mode distance gate.
SIM_SHIP_ENABLE   1
SIM_SHIP_EXT      1
SIM_SHIP_SYSID    17
SIM_SHIP_SPEED    0

# Center yaw without overriding the default low throttle.
FS_THR_ENABLE     0
FLTMODE_CH        0
GUID_OPTIONS      4

# Direct TCP is serial link 0; request navigation/state streams explicitly.
SR0_EXT_STAT       2
SR0_EXTRA1         5
SR0_POSITION       5
