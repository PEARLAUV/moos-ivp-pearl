//-------------------------------------------------
// FILE: meta_shoreside.moos
// NAME: Charles Benjamin
//-------------------------------------------------

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = shoreside

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100
  // MOOS treats // as an inline comment; the wrapper expands udp: to udp://.
  QGCParams = --endpoint=udp:100.112.119.114:14550

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = uLoadWatch      @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = uFldNodeComms   @ NewConsole = false
  Run = pMediator       @ NewConsole = false
  Run = uTimerScript    @ NewConsole = false ~ uMediatorPrime
  Run = pRouteBuffer    @ NewConsole = false
  Run = pEchoVar        @ NewConsole = false ~ uFieldRelay
#ifdef LAUNCH_GUI yes
  Run = moos-vnc-session  @ NewConsole=false ~ pMarineViewer
  Run = qgc-vnc-session   @ NewConsole=false,ExtraProcessParams=QGCParams ~ qGroundControl
  Run = moos-ttyd-session @ NewConsole=false ~ mission-terminal
#endif
  Run = pWebSocketServer @ NewConsole = false
}

ProcessConfig = pWebSocketServer
{
  AppTick          = 4
  CommsTick        = 4
  WSPort           = 9090
  AllowSubmissions = false
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)
#ifdef UAV_DIRECT_ENABLE yes
  // Keep a deterministic shoreside-to-UAV path on the UAV's Tailnet address.
  // This is ordinary pShare unicast, not a PEARL relay.
  output = src_name=MEDIATED_MESSAGE_LOCAL, dest_name=MEDIATED_MESSAGE, route=$(UAV_IP):$(UAV_PSHARE)
  output = src_name=ACK_MESSAGE_LOCAL, dest_name=ACK_MESSAGE, route=$(UAV_IP):$(UAV_PSHARE)
#endif
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1

  default_hostip_force = $(IP_ADDR=localhost)
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  // Docker/VNC launchers are supervised by pAntler, not MOOSDB clients.
  // uProcessWatch cannot infer their health from MOOSDB connections.
  nowatch           = qGroundControl
  nowatch           = mission-terminal
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1

#ifdef LAUNCH_GUI yes
  thresh = app=pMarineViewer, gapthresh=5
#endif
  thresh = app=uFldNodeComms, gapthresh=4
  thresh = app=pHostInfo,     gapthresh=5
  thresh = app=any,           gapthresh=2.0

  breach_trigger = 5
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_SHORESIDE
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//----------------------------------------------------
// pMediator carries both the existing UAV operator commands and the new
// vehicle-to-vehicle rendezvous protocol.
ProcessConfig = pMediator
{
  AppTick   = 4
  CommsTick = 4

  vname         = shoreside
  mates         = uav
  resend_thresh = 1
  max_tries     = 10
}

//----------------------------------------------------
// pMediator sequence zero is acknowledged but not delivered. Consume it with
// a harmless UAV message before any mediated operator command is sent.
ProcessConfig = uMediatorPrime
{
  AppTick   = 10
  CommsTick = 10

  paused      = false
  reset_max   = 0
  script_name = SHORE_MEDIATOR_PRIME

  event = var=NODE_MESSAGE_LOCAL, val="src_node=shoreside,dest_node=uav,var_name=SHORE_MEDIATOR_SYNC,string_val=true", time=0
}

//----------------------------------------------------
ProcessConfig = pRouteBuffer
{
  AppTick   = 4
  CommsTick = 4

  role             = shoreside
  source_node      = shoreside
  destination_node = uav
  max_points       = 50
  contact_max_age  = 3
}

//----------------------------------------------------
// Normalize ACK destination names for addressed qbridge routing.
ProcessConfig = uFieldRelay
{
  AppTick   = 4
  CommsTick = 4

  Echo = ACK_MESSAGE_uav   -> ACK_MESSAGE_UAV
  Echo = ACK_MESSAGE_pearl -> ACK_MESSAGE_PEARL
}

//----------------------------------------------------
ProcessConfig = uFldShoreBroker
{
  AppTick   = 4
  CommsTick = 4

  auto_bridge_appcast  = true
  auto_bridge_realmcast = false

  bridge = src=MEDIATED_MESSAGE_LOCAL, alias=MEDIATED_MESSAGE
  bridge = src=ACK_MESSAGE_LOCAL, alias=ACK_MESSAGE

  // uFldNodeComms produces addressed *_UAV and *_PEARL variables for
  // vehicle-to-vehicle mediated traffic and acknowledgements.
  qbridge = MEDIATED_MESSAGE
  qbridge = ACK_MESSAGE

  qbridge = HEARTBEAT
  qbridge = NODE_REPORT

  // Destination suffixes address canonical task triggers to either vehicle;
  // the remaining Helm controls are addressed to PEARL.
  qbridge = TASK_EXECUTE
  qbridge = RENDEZVOUS_ABORT
  qbridge = DEPLOY
  qbridge = RETURN
  qbridge = STATION_KEEP
  qbridge = MOOS_MANUAL_OVERRIDE
  qbridge = PEARL_ALLSTOP
}

//----------------------------------------------------
ProcessConfig = uFldNodeComms
{
  AppTick   = 2
  CommsTick = 2

  comms_range      = 1000
  critical_range   = 25
  min_msg_interval = 1
  max_msg_length   = 1000
  // Rendezvous partners are intentionally in different platform groups.
  groups           = false

  view_node_rpt_pulses = false
}

//----------------------------------------------------
ProcessConfig = pMarineViewer
{
  AppTick   = 4
  CommsTick = 4

  beat_flag = HEARTBEAT_ALL=true

  // Same Charles River map and framing used by may_test_run.
  tiff_file           = MIT_SP.tif
  set_pan_x           = 0
  set_pan_y           = -400
  zoom                = 1
  vehicle_shape_scale = 1.5
  vehicles_name_mode  = names
  trails_length       = 100

  appcast_viewable     = true
  appcast_height       = 70
  appcast_width        = 35
  appcast_color_scheme = indigo
  appcast_font_size    = large
  procs_font_size      = large
  nodes_font_size      = large

  comms_pulse_viewable_all = true
  stale_report_thresh      = 10
  stale_remove_thresh      = 30

  scope = NAV_ALTITUDE
  scope = UAV_IS_ARMED
  scope = UAV_LANDED_STATE
  scope = UAV_COMMAND_RESULT
  scope = UAV_BATTERY_SOC
  scope = UAV_BATTERY_VOLTAGE
  scope = UAV_BATTERY_DATA_VALID
  scope = UAV_BATTERY_DATA_AGE
  scope = UAV_TASK_ACTIVE
  scope = UAV_TASK_TAKEOFF_REQUESTED
  scope = UAV_TASK_ROUTE_STARTED
  scope = UAV_TASK_REJECTION
  scope = AUTOPILOT_MODE
  scope = CONTROL_AUTHORITY
  scope = IVPHELM_STATE
  scope = IVPHELM_MODESET
  scope = IVPHELM_STATEVARS
  scope = VEHICLE_PROC_WATCH_ALL_OK
  scope = PEARL_PROC_WATCH_ALL_OK
  scope = ROUTE_BUFFER_STATE
  scope = ROUTE_BUFFER_COUNT
  scope = ROUTE_BUFFER_VEHICLE_STATE
  scope = TASK_EXECUTE
  scope = RENDEZVOUS_ABORT
  scope = DEPLOY
  scope = RETURN
  scope = STATION_KEEP
  scope = MOOS_MANUAL_OVERRIDE
  scope = PEARL_ALLSTOP
#include plug_pearl_fsm_scopes.moos
#include plug_uav_fsm_scopes.moos
  scope = TAKEOFF_REQUEST_ID
  scope = TAKEOFF_REQUEST_STATE
  scope = UAV_TAKEOFF_PROGRESS
  scope = TAKEOFF_PRECHECKS_STATE
  scope = PEARL_TAKEOFF_PRECHECKS_SNAPSHOT
  scope = PEARL_TAKEOFF_POSTCHECKS_SNAPSHOT
  scope = UAV_TAKEOFF_PRECHECKS_SNAPSHOT
  scope = TAKEOFF_SUPPORT_ACTIVE
  scope = TAKEOFF_SUPPORT_READY
  scope = TAKEOFF_POSTCHECKS_STATE
  scope = TAKEOFF_CLEARANCE_STATE
  scope = TAKEOFF_CANCEL_STATE
  scope = PEARL_TAKEOFF_GATE_READY
  scope = PEARL_TAKEOFF_GATE_REASON
  scope = PEARL_TAKEOFF_CONTROL_HISTORY
  scope = PEARL_TAKEOFF_CONTROL_RESTORED
  scope = RECOVERY_REQUEST_ID
  scope = RECOVERY_REQUEST_STATE
  scope = RECOVERY_PRECHECKS_STATE
  scope = RECOVERY_PRECHECKS_STATE_STATE
  scope = PEARL_RECOVERY_PRECHECKS_SNAPSHOT
  scope = RECOVERY_CHECK_DRONEPORT_OPEN
  scope = RECOVERY_CHECK_DRONEPORT_OPEN_STATE
  scope = RENDEZVOUS_STATE
  scope = RECOVERY_SUPPORT_ACTIVE
  scope = RECOVERY_SUPPORT_READY
  scope = RECOVERY_POSTCHECKS_STATE
  scope = LANDING_CLEARANCE_STATE
  scope = RECOVERY_CANCEL_STATE
  scope = RECOVERY_SUPPORT_OUTCOME
  scope = BASE_RESTORE_STATE
  scope = PEARL_HELM_DEPLOY
  scope = PEARL_HELM_RETURN
  scope = PEARL_HELM_STATION_KEEP
  scope = PEARL_HELM_MANUAL_OVERRIDE
  scope = PEARL_RENDEZVOUS_ACTIVE
  scope = PEARL_RENDEZVOUS_ARRIVED
  scope = PEARL_CONTROL_HISTORY
  scope = PEARL_CONTROL_RESTORED
  scope = UAV_RENDEZVOUS_STATE
  scope = PEARL_RENDEZVOUS_STATE
  scope = UAV_RENDEZVOUS_PHASE
  scope = PEARL_RENDEZVOUS_PHASE
  scope = UAV_RENDEZVOUS_SESSION
  scope = PEARL_RENDEZVOUS_SESSION
  scope = UAV_RENDEZVOUS_ARRIVED
  scope = UAV_LANDING_TARGET_STATE
  scope = UAV_SECONDARY_RECOVERY_STATE
  scope = UAV_SECONDARY_RECOVERY_POINT
  scope = UAV_SECONDARY_RECOVERY_DISTANCE
  scope = UAV_LANDING_GATE_READY
  scope = UAV_LANDING_GATE_REASON
  scope = UAV_LANDING_TARGET_LOCK_AGE
  scope = UAV_LANDING_APPROACH_POINT
  scope = UAV_PEER_DISTANCE
  scope = UAV_PREC_LAND_RESULT
  scope = PEARL_LANDING_GATE_READY
  scope = PEARL_LANDING_GATE_REASON
  scope = PEARL_UAV_SEPARATION
  scope = UAV_LANDING_TARGET_AVAILABLE
  scope = UAV_LANDING_TARGET_AGE
  scope = UAV_LANDING_TARGET_TIME_USEC
  scope = UAV_LANDING_TARGET_SYSTEM_ID
  scope = UAV_LANDING_TARGET_COMPONENT_ID
  scope = UAV_LANDING_TARGET_TARGET_NUM
  scope = UAV_LANDING_TARGET_FRAME
  scope = UAV_LANDING_TARGET_TYPE
  scope = UAV_LANDING_TARGET_POSITION_VALID
  scope = UAV_LANDING_TARGET_ANGLE_X
  scope = UAV_LANDING_TARGET_ANGLE_Y
  scope = UAV_LANDING_TARGET_DISTANCE
  scope = UAV_LANDING_TARGET_SIZE_X
  scope = UAV_LANDING_TARGET_SIZE_Y
  scope = UAV_LANDING_TARGET_X
  scope = UAV_LANDING_TARGET_Y
  scope = UAV_LANDING_TARGET_Z
  scope = UAV_LANDING_TARGET_Q_W
  scope = UAV_LANDING_TARGET_Q_X
  scope = UAV_LANDING_TARGET_Q_Y
  scope = UAV_LANDING_TARGET_Q_Z
  scope = UAV_LANDING_TARGET_HEALTH_AGE
  scope = PARDUBRIDGE_PASSIVE_STATE
  scope = PARDUBRIDGE_PASSIVE_CONNECTED
  scope = RENDEZVOUS_POINT
  scope = PEARL_BATTERY_SOC
  scope = PEARL_BATTERY_CHARGING
  scope = PEARL_BATTERY_DATA_VALID
  scope = PEARL_BATTERY_DATA_AGE
  scope = PEARL_WIND_SPEED
  scope = PEARL_WIND_DATA_VALID
  scope = PEARL_AIRMAR_DATA_AGE
  scope = ALFA_LINK_UP
  scope = ALFA_STATION_COUNT
  scope = ALFA_SIGNAL_DBM
  scope = ALFA_SIGNAL_AVG_DBM
  scope = ALFA_TX_BITRATE_MBPS
  scope = ALFA_RX_BITRATE_MBPS
  scope = ALFA_TX_RETRIES_TOTAL
  scope = ALFA_TX_FAILED_TOTAL
  scope = ALFA_INACTIVE_MS
  scope = ALFA_DATA_VALID
  scope = ALFA_DATA_AGE
  scope = ALFA_SIGNAL_DATA_VALID

  // Precision landing is committed only by pRendezvous after clearance and
  // target-lock gates pass; there is intentionally no direct landing button.
  left_context[uav-route] = ROUTE_POINT = "x=$[XPOS],y=$[YPOS]"
  right_context[uav-clear] = ROUTE_BUFFER_CLEAR=true
  right_context[uav-clear] = NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=uav,var_name=UAV_TASK_CANCEL,string_val=true"

  button_1 = TASK-PEARL # TASK_EXECUTE_PEARL=true # PEARL_ALLSTOP_PEARL=false
  button_2 = TASK-UAV # TASK_EXECUTE_UAV=true # ROUTE_BUFFER_DEPLOY=true # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=uav,var_name=UAV_TASK_REQUEST,string_val=true"
  button_3 = LOCK-DRONEPORT # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=pearl,var_name=PEARL_DRONEPORT_BAY_COVER_STATE,string_val=closed" # color=yellow

  // button_4 = UAV DISARM # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=uav,var_name=UAV_DISARM_REQUEST,string_val=true" # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=uav,var_name=UAV_TASK_CANCEL,string_val=true" # color=red
  // button_8 = PEARL RETURN # DEPLOY_PEARL=true # RETURN_PEARL=true # STATION_KEEP_PEARL=false # PEARL_ALLSTOP_PEARL=false # MOOS_MANUAL_OVERRIDE_PEARL=false
  // button_9 = PEARL STATION # DEPLOY_PEARL=true # RETURN_PEARL=false # STATION_KEEP_PEARL=true # PEARL_ALLSTOP_PEARL=false # MOOS_MANUAL_OVERRIDE_PEARL=false
  // button_10 = PEARL ALLSTOP # PEARL_ALLSTOP_PEARL=true # color=red
}
