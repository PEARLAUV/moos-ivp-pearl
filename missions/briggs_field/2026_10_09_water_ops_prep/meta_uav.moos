//-------------------------------------------------
// FILE: meta_uav.moos
// NAME: Charles Benjamin
//-------------------------------------------------

// All processes in this community use the local MOOSDB. IP_ADDR is reserved
// for the externally advertised pShare address in pHostInfo below.
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 50

  Run = MOOSDB         @ NewConsole = false
  Run = pRealm         @ NewConsole = false
  Run = uProcessWatch  @ NewConsole = false
  Run = uLoadWatch     @ NewConsole = false
  Run = pShare         @ NewConsole = false
  Run = pHostInfo      @ NewConsole = false
  Run = pLogger        @ NewConsole = false
#ifdef VIDEO_RECORDING true
  Run = pVideoRecorder @ NewConsole = false
#endif
  Run = pNodeReporter  @ NewConsole = false
  Run = uFldNodeBroker @ NewConsole = false
  Run = uFldMessageHandler @ NewConsole = false
  Run = pMediatorRouter @ NewConsole = false
  Run = pMediator      @ NewConsole = false
  Run = uTimerScript   @ NewConsole = false ~ uMediatorPrime
  Run = pRouteBuffer   @ NewConsole = false
  Run = pTakeoffCoordinator @ NewConsole = false
  Run = pRendezvous    @ NewConsole = false
  Run = pLandingCoordinator @ NewConsole = false
  Run = pRallyPoint @ NewConsole = false
  Run = pLandingTargetViewer @ NewConsole = false
  Run = pFSMRuntime    @ NewConsole = false
  Run = uChecks        @ NewConsole = false ~ uPretakeoffChecks
  Run = uChecks        @ NewConsole = false ~ uAirborneChecks
  Run = uChecks        @ NewConsole = false ~ uLandingAirborneChecks
  Run = uChecks        @ NewConsole = false ~ uLandingYawChecks
  Run = uChecks        @ NewConsole = false ~ uLandingGroundChecks
  Run = pHelmIvP       @ NewConsole = false
  Run = uTimerScript   @ NewConsole = false ~ uRouteClear
  Run = uTimerScript   @ NewConsole = false ~ uDeployGuard
  Run = uTimerScript   @ NewConsole = false ~ uOperatorDisarm
#ifdef XMODE SITL
  Run = pMavlinkShipBridge @ NewConsole = false
  Run = pMavlinkLandingTarget @ NewConsole = false
#endif
  Run = pArduBridge    @ NewConsole = false
  Run = pEchoVar       @ NewConsole = false
  Run = pDeadManPost   @ NewConsole = false
  Run = uTimerScript   @ NewConsole = false ~ uRouteSequence
  Run = uTimerScript   @ NewConsole = false ~ uRendezvousSequence
  Run = uTimerScript   @ NewConsole = false ~ uSecondarySequence
  Run = uTimerScript   @ NewConsole = false ~ uSecondaryLand
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)

  // UAV FSM observability is sent directly to shoreside. Only the UAV-owned
  // operation and nested phase states needed by PEARL cross the authority boundary.
#include plug_uav_fsm_pshare.moos
  // Outgoing-only dispatch; each peer receives directly in its native mediator.
  // Protocol paths are always direct, independent of optional peer telemetry.
  output = src_name=MEDIATED_TX_SHORESIDE, dest_name=MEDIATED_MESSAGE, route=$(SHORE_IP):$(SHORE_PSHARE)
  output = src_name=ACK_TX_SHORESIDE, dest_name=ACK_MESSAGE, route=$(SHORE_IP):$(SHORE_PSHARE)
  output = src_name=MEDIATED_TX_PEARL, dest_name=MEDIATED_MESSAGE, route=$(PEARL_IP):$(PEARL_PSHARE)
  output = src_name=ACK_TX_PEARL, dest_name=ACK_MESSAGE, route=$(PEARL_IP):$(PEARL_PSHARE)
#ifdef DIRECT_PEER true
  output = src_name=NODE_REPORT_LOCAL, dest_name=NODE_REPORT, route=$(PEARL_IP):$(PEARL_PSHARE)
  output = src_name=UAV_FSM_OPERATION_STATE,          route=$(PEARL_IP):$(PEARL_PSHARE)
  output = src_name=UAV_FSM_LANDING_OPERATIONS_STATE, route=$(PEARL_IP):$(PEARL_PSHARE)
  // Recovery/point/session negotiation is mediated, never direct peer status.


#endif
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

#ifdef XMODE SITL
  thresh = app=pMavlinkShipBridge, gapthresh=3
#endif
  thresh = app=pArduBridge,    gapthresh=3
  thresh = app=pHelmIvP,       gapthresh=3
  thresh = app=pTakeoffCoordinator, gapthresh=3
  thresh = app=pNodeReporter,  gapthresh=4
  thresh = app=pHostInfo,      gapthresh=5
  thresh = app=any,            gapthresh=2

  breach_trigger = 5
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  // Pin the broker-advertised address to --ip. This prevents automatic
  // interface discovery from selecting Wi-Fi, Ethernet, or Tailscale.
  default_hostip_force = $(IP_ADDR=localhost)
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_$(VNAME)
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//----------------------------------------------------
#ifdef VIDEO_RECORDING true
ProcessConfig = pVideoRecorder
{
  AppTick   = 4
  CommsTick = 4

  // MediaMTX performs all file I/O on the UAV. This app only controls its API.
  // The UAV FSM starts it on task admission. It stops after a confirmed nominal
  // landing or grounded pre-takeoff abort, but continues in OFFNOMINAL.
  // The API is trusted on the private network and does not require credentials.
  api_url           = $(VIDEO_API_URL)
  record_root       = $(VIDEO_RECORD_ROOT)
  recording_id_var  = UAV_ROUTE_ACTIVE_ID
  segment_duration  = 1m
  http_timeout      = 5

  // Logical camera names are independent of the existing MediaMTX path names:
  // fpv records MediaMTX oak, and nadir records MediaMTX lores. This preserves
  // the board configuration while giving archives stable camera names.
  path = fpv:oak
  path = nadir:lores
  activation = fpv:/opt/oak-stream/run-on-demand
  activation = nadir:/opt/landmark-camera-tap/bin/run-lores-on-demand
}
#endif

//----------------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  platform_type   = quadcopter
  platform_color  = $(COLOR)
  platform_length = $(PLATFORM_LENGTH=4)
  platform_group  = drone

  cross_fill_policy = global
  report_cog        = true
}

//----------------------------------------------------
// Outgoing-only mediated dispatch; transport delivers directly to peer pMediator.
// No routes deliver to *_IN and relay is disabled; pShare stays payload-opaque.
ProcessConfig = pMediatorRouter
{
  AppTick = 40
  CommsTick = 40
  vname = $(VNAME)
  peer = pearl
  peer = shoreside
  allow_relay = false
}

//----------------------------------------------------
ProcessConfig = pMediator
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  vname         = $(VNAME)
  mates         = shoreside,pearl
  resend_thresh = 1
  max_tries     = 10
}

//----------------------------------------------------
ProcessConfig = uFldMessageHandler
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  strict_addressing = true
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  ok_skew   = any
  behaviors = targ_$(VNAME).bhv

  // Load the shared supervisory behavior used by the UAV companion FSM.
  ivp_behavior_dir = $(PEARL_LIB_DIR)

  start_in_drive   = true
  park_on_allstop  = false
  Domain    = course:0:359:360
  Domain    = speed:0:5:51
  Domain    = altitude:0:30:61
}

//----------------------------------------------------
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  auto_bridge_realmcast = false
  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

  bridge = src=NODE_REPORT_LOCAL, alias=NODE_REPORT,frequency=4,behavior=latest
  // Mediated protocol routes are explicitly addressed in pShare above.
  bridge = src=VIEW_POINT,frequency=1,behavior=coalesce
  bridge = src=VIEW_CIRCLE,frequency=1,behavior=coalesce
  bridge = src=VIEW_POLYGON,frequency=1,behavior=coalesce
  bridge = src=VIEW_SEGLIST,frequency=1,behavior=coalesce
  bridge = src=VIEW_MARKER,frequency=1,behavior=coalesce
  bridge = src=VIEW_VECTOR,frequency=1,behavior=coalesce
  bridge = src=APPCAST

  bridge = src=UAV_COMMAND_RESULT
  bridge = src=UAV_BATTERY_SOC
  bridge = src=UAV_BATTERY_VOLTAGE
  bridge = src=UAV_BATTERY_DATA_VALID
  bridge = src=UAV_BATTERY_DATA_AGE
#ifdef VIDEO_RECORDING true
  bridge = src=VIDEO_RECORD_STATE
  bridge = src=VIDEO_RECORDING
  bridge = src=VIDEO_RECORD_COMMAND_RESULT
  bridge = src=VIDEO_RECORD_LOG_DIRECTORY
  bridge = src=VIDEO_RECORD_ID
  bridge = src=VIDEO_RECORD_HOST
  bridge = src=VIDEO_RECORD_DIRECTORY
  bridge = src=VIDEO_RECORD_LOCATION
  bridge = src=VIDEO_RECORD_STREAMS
  bridge = src=VIDEO_RECORD_SEGMENT_DURATION
  bridge = src=VIDEO_RECORD_API_URL
  bridge = src=VIDEO_RECORD_API_REACHABLE
  bridge = src=VIDEO_RECORD_LAST_HTTP_STATUS
  bridge = src=VIDEO_RECORD_LAST_ERROR
  bridge = src=VIDEO_RECORD_START_COUNT
  bridge = src=VIDEO_RECORD_STOP_COUNT
#endif
  // Local uChecks results are unprefixed; preserve their UAV names on shore.
  bridge = src=TAKEOFF_PRECHECK_GPS, alias=UAV_TAKEOFF_PRECHECK_GPS
  bridge = src=TAKEOFF_PRECHECK_GPS_STATE, alias=UAV_TAKEOFF_PRECHECK_GPS_STATE
  bridge = src=TAKEOFF_PRECHECK_FLIGHT_PLAN, alias=UAV_TAKEOFF_PRECHECK_FLIGHT_PLAN
  bridge = src=TAKEOFF_PRECHECK_FLIGHT_PLAN_STATE, alias=UAV_TAKEOFF_PRECHECK_FLIGHT_PLAN_STATE
  bridge = src=TAKEOFF_PRECHECKS, alias=UAV_TAKEOFF_PRECHECKS
  bridge = src=TAKEOFF_PRECHECKS_STATE, alias=UAV_TAKEOFF_PRECHECKS_STATE
  bridge = src=TAKEOFF_PRECHECKS_SNAPSHOT, alias=UAV_TAKEOFF_PRECHECKS_SNAPSHOT,frequency=1,behavior=coalesce
  bridge = src=TAKEOFF_PRECHECK_BATTERY, alias=UAV_TAKEOFF_PRECHECK_BATTERY
  bridge = src=TAKEOFF_PRECHECK_BATTERY_STATE, alias=UAV_TAKEOFF_PRECHECK_BATTERY_STATE
  bridge = src=TAKEOFF_PRECHECK_ARMABLE, alias=UAV_TAKEOFF_PRECHECK_ARMABLE
  bridge = src=TAKEOFF_PRECHECK_ARMABLE_STATE, alias=UAV_TAKEOFF_PRECHECK_ARMABLE_STATE
  // Addressed aliases avoid colliding with PEARL's TAKEOFF_REQUEST_STATE.
  bridge = src=TAKEOFF_REQUEST_RESULT, alias=UAV_TAKEOFF_REQUEST_RESULT
  bridge = src=TAKEOFF_REQUEST_STATE,  alias=UAV_TAKEOFF_REQUEST_STATE
  bridge = src=TAKEOFF_REQUEST_REASON, alias=UAV_TAKEOFF_REQUEST_REASON
  bridge = src=UAV_IS_ARMED
  bridge = src=TAKEOFF_AIRBORNE
  bridge = src=TAKEOFF_AIRBORNE_STATE
  bridge = src=TAKEOFF_AIRBORNE_SNAPSHOT,frequency=1,behavior=coalesce
  bridge = src=LANDING_AIRBORNE_CHECKS
  bridge = src=LANDING_GROUND_CHECKS
  bridge = src=UAV_LANDED_STATE
  bridge = src=UAV_TASK_ACTIVE
  bridge = src=UAV_TASK_TAKEOFF_REQUESTED
  bridge = src=UAV_TASK_ROUTE_STARTED
  bridge = src=UAV_TASK_REJECTION
  // Shore-only latest diagnostics at 2 Hz; native local observations and
  // MAVLink target generation retain their original rate and timestamps.
  bridge = src=UAV_LANDING_TARGET_AVAILABLE,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_AGE,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_TIME_USEC,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_SYSTEM_ID,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_COMPONENT_ID,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_TARGET_NUM,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_FRAME,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_TYPE,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_POSITION_VALID,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_ANGLE_X,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_ANGLE_Y,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_DISTANCE,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_SIZE_X,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_SIZE_Y,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_X,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_Y,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_Z,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_Q_W,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_Q_X,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_Q_Y,frequency=2,behavior=latest
  bridge = src=UAV_LANDING_TARGET_Q_Z,frequency=2,behavior=latest
  bridge = src=LANDING_OWN_PHASE, alias=LANDING_UAV_PHASE,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_SESSION, alias=LANDING_UAV_SESSION,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_REASON, alias=LANDING_UAV_REASON,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_CHECKS_READY, alias=LANDING_UAV_CHECKS_READY,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_TARGET_FRESH, alias=LANDING_UAV_TARGET_FRESH,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_YAW_STATE, alias=LANDING_UAV_YAW_STATE,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_YAW_INPUT_REASON, alias=LANDING_UAV_YAW_INPUT_REASON,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_YAW_ERROR, alias=LANDING_UAV_YAW_ERROR,frequency=2,behavior=latest
  bridge = src=LANDING_YAW_CHECKS, alias=LANDING_UAV_YAW_CHECKS,frequency=1,behavior=coalesce
  bridge = src=LANDING_OWN_RENDEZVOUS_PHASE, alias=LANDING_UAV_RENDEZVOUS_PHASE,frequency=1,behavior=coalesce
  bridge = src=LANDING_TARGET_VIEW_ACTIVE,frequency=1,behavior=coalesce
  bridge = src=AUTOPILOT_MODE
  bridge = src=CONTROL_AUTHORITY
  bridge = src=IVPHELM_STATE,frequency=1,behavior=coalesce
  bridge = src=PROC_WATCH_ALL_OK, alias=VEHICLE_PROC_WATCH_ALL_OK
  bridge = src=ROUTE_BUFFER_VEHICLE_STATE
  bridge = src=RENDEZVOUS_OWN_PHASE, alias=RENDEZVOUS_UAV_PHASE
  bridge = src=RENDEZVOUS_OWN_SESSION, alias=RENDEZVOUS_UAV_SESSION
  bridge = src=RENDEZVOUS_OWN_POINT, alias=RENDEZVOUS_UAV_POINT
  bridge = src=RENDEZVOUS_OWN_POINT_FROZEN, alias=RENDEZVOUS_UAV_POINT_FROZEN
  bridge = src=RENDEZVOUS_OWN_MOTION, alias=RENDEZVOUS_UAV_MOTION
  bridge = src=RENDEZVOUS_OWN_ARRIVED, alias=RENDEZVOUS_UAV_ARRIVED
  bridge = src=RALLY_ACTIVE
  bridge = src=RALLY_TASK_STATE
  bridge = src=RALLY_TASK_REASON
  bridge = src=UAV_RALLY_READY
  bridge = src=UAV_RALLY_ID
  bridge = src=UAV_RALLY_STATE
  bridge = src=SECONDARY_ARRIVED
#ifdef XMODE SITL
  bridge = src=MAVLINK_SHIP_BRIDGE_CONNECTED,frequency=1,behavior=coalesce
  bridge = src=MAVLINK_SHIP_POSE_ACTIVE,frequency=1,behavior=coalesce
  bridge = src=LANDMARK_EMULATOR_ACTIVE,frequency=1,behavior=coalesce
  bridge = src=LANDMARK_EMULATOR_DISTANCE,frequency=2,behavior=latest
  bridge = src=LANDMARK_EMULATOR_CONDITIONS_MET,frequency=1,behavior=coalesce
  bridge = src=MAVLINK_LANDING_TARGET_CONNECTED,frequency=1,behavior=coalesce
  bridge = src=SIM_UAV_ON_SHIP
#endif
  bridge = src=NAV_ALTITUDE,frequency=5,behavior=latest
  bridge = src=UAV_ALTITUDE_MSL,frequency=5,behavior=latest
  bridge = src=DESIRED_HEADING
  bridge = src=DESIRED_SPEED
  bridge = src=DESIRED_ALTITUDE
}

//----------------------------------------------------
ProcessConfig = pFSMRuntime
{
  AppTick   = 4
  CommsTick = 4

  // Debug/visualization aid. Set by --min_state_time in launch.sh.
  min_state_time = $(MIN_STATE_TIME)

#include plug_uav_fsm_runtime.moos
}

//----------------------------------------------------
ProcessConfig = uPretakeoffChecks
{
  AppTick = 4
  CommsTick = 4
  condition = (UAV_FSM_TAKEOFF_OPERATIONS_STATE=ESTABLISHING_TAKEOFF_READINESS) or (UAV_FSM_TAKEOFF_OPERATIONS_STATE=REQUESTING_TAKEOFF_CLEARANCE)
  result_var = TAKEOFF_PRECHECKS
  result_prefix = TAKEOFF_PRECHECK_

  session_var = UAV_FSM_OPERATION_STATE_TAKEOFF_OPERATIONS_EPOCH

  check = name=GPS,timeout=60,max_age=3,success_hold=5
  require = check=GPS,var=UAV_GPS_AVAILABLE,type=double,equals=1,on_mismatch=wait
  require = check=GPS,var=UAV_GPS_FIX_TYPE,type=double,min=3,on_mismatch=wait
  require = check=GPS,var=UAV_GPS_AGE,type=double,min=0,max=3,on_mismatch=wait

  check = name=FLIGHT_PLAN,timeout=60
  require = check=FLIGHT_PLAN,var=ROUTE_READY,type=string,equals=true,on_mismatch=wait
  // Current admitted transaction AND actual FC ACK/readback are required.
  // Task admission enters readiness before verification; an old FC READY
  // flag alone cannot qualify the newly tasked rally.
  require = check=FLIGHT_PLAN,var=RALLY_TASK_STATE,type=string,equals=READY,on_mismatch=wait
  require = check=FLIGHT_PLAN,var=UAV_RALLY_READY,type=double,equals=1,on_mismatch=wait

  check = name=BATTERY,timeout=5,max_age=3
  require = check=BATTERY,var=UAV_BATTERY_DATA_VALID,type=double,equals=1,on_mismatch=fail
  require = check=BATTERY,var=UAV_BATTERY_SOC,type=double,min=30,on_mismatch=fail

  check = name=ARMABLE,timeout=30,max_age=3,success_hold=5
  require = check=ARMABLE,var=UAV_IS_ARMABLE,type=double,equals=1,on_mismatch=wait
  require = check=ARMABLE,var=UAV_IS_ARMED,type=double,equals=0,on_mismatch=fail

  check = name=LANDED,timeout=10,max_age=3,success_hold=5
  require = check=LANDED,var=UAV_LANDED_STATE,type=string,equals=ON_GROUND,on_mismatch=fail
  require = check=LANDED,var=UAV_LANDED_STATE_AGE,type=double,min=0,max=3,on_mismatch=wait

  check = name=HEALTHY,timeout=10,max_age=3,success_hold=5
  require = check=HEALTHY,var=UAV_HEALTH_AVAILABLE,type=double,equals=1,on_mismatch=wait
  require = check=HEALTHY,var=UAV_HEALTH_ALL_OK,type=double,equals=1,on_mismatch=wait

  check = name=GUIDED,timeout=30,max_age=3
  require = check=GUIDED,var=UAV_GUIDED_MODE_ACTIVE,type=double,equals=1,on_mismatch=wait
  require = check=HEALTHY,var=UAV_HEALTH_AGE,type=double,min=0,max=3,on_mismatch=wait
}


//----------------------------------------------------
#include plug_uav_ardupilot.moos

#ifdef XMODE SITL
ProcessConfig = pMavlinkShipBridge
{
  AppTick   = 20
  CommsTick = 20
  term_report_interval = 2

  mavlink_host        = 127.0.0.1
  mavlink_port        = $(SITL_ROUTER_PORT)
  ship_system_id      = 17
  source_component_id = 191
  publish_rate_hz     = 10
  input_timeout       = 1
  // Attachment/deck surface only; no UAV inputs or visual observations.
  ship_nav_prefix     = PEARL_NAV
  ship_pose_enable_var = SIM_UAV_ON_SHIP
  ship_altitude_msl   = $(DECK_ALTITUDE=1)
}

//----------------------------------------------------
ProcessConfig = pMavlinkLandingTarget
{
  AppTick   = 20
  CommsTick = 20

  mavlink_host        = 127.0.0.1
  mavlink_port        = $(SITL_ROUTER_PORT)
  target_system_id    = 1
  source_component_id = 191
  target_number       = 0
  publish_rate_hz     = 10
  input_timeout       = 1
  target_nav_prefix   = PEARL_NAV
  vehicle_nav_prefix  = UAV_NAV
  // Native FC packets on the sensor endpoint; no relayed aircraft-pose fallback.
  vehicle_pose_source = mavlink
  native_pose_rate_hz = 50
  native_pose_timeout = 0.10 // real receive seconds; also caps FC timestamp age
  native_pose_max_skew = 0.02 // FC seconds between position and attitude
  detection_range     = $(TARGET_RANGE=12)
  // Match the attachment app's deck MSL height, or use the same live height
  // variable in target_altitude_var and ship_altitude_var.
  target_altitude_msl = $(DECK_ALTITUDE=1)
  show_visuals = true
}
#endif

//----------------------------------------------------
ProcessConfig = pEchoVar
{
  AppTick   = 10
  CommsTick = 10

  // Keep native UAV_* health and landing-target telemetry intact while mapping
  // only ArduPilot navigation into the Helm's NAV_* interface.
#ifdef XMODE SITL
  // Local native flight telemetry for the independent landmark producer.
  Echo = UAV_LAT          -> UAV_NAV_LAT
  Echo = UAV_LON          -> UAV_NAV_LONG
  Echo = UAV_YAW          -> UAV_NAV_HEADING
  Echo = UAV_ROLL -> UAV_NAV_ROLL
  Echo = UAV_PITCH -> UAV_NAV_PITCH
  Echo = UAV_ATTITUDE_AVAILABLE -> UAV_NAV_ATTITUDE_AVAILABLE
  Echo = UAV_ATTITUDE_AGE -> UAV_NAV_ATTITUDE_AGE
  Echo = UAV_ATTITUDE_TIME_USEC -> UAV_NAV_ATTITUDE_TIME_USEC
  Echo = UAV_ATTITUDE_SAMPLES -> UAV_NAV_ATTITUDE_SAMPLES
  Echo = UAV_ALTITUDE_MSL -> UAV_NAV_ALTITUDE_MSL
#endif
  Echo = UAV_X        -> NAV_X
  Echo = UAV_Y        -> NAV_Y
  Echo = UAV_LAT      -> NAV_LAT
  Echo = UAV_LON      -> NAV_LONG
  Echo = UAV_SPEED    -> NAV_SPEED
  // Body attitude and travel direction are different when hovering/crabbing.
  // Both are grid bearings; true-north UAV_YAW above remains for target geometry.
  Echo = UAV_HEADING  -> NAV_HEADING
  Echo = UAV_COG      -> NAV_COG
  Echo = UAV_ALTITUDE -> NAV_ALTITUDE
  Echo = UAV_DEPTH    -> NAV_DEPTH
}

//----------------------------------------------------
ProcessConfig = pRouteBuffer
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  role = vehicle
  // Allow a cleared Helm behavior to publish its end flags before releasing
  // a replacement route (notably rendezvous -> secondary recovery).
  deploy_delay = 2
  route_deploy_var = ROUTE_EXECUTE
  route_purpose_var = ROUTE_EXECUTE_PURPOSE
  operation_state_var = UAV_FSM_OPERATION_STATE
  // Retain snapshots while PARKED; deliver once Helm has loaded its templates.
  helm_state_var = IVPHELM_STATE
  // Parked Helm may retain old instances; only the current identity may run.
  route_identity_var = UAV_ROUTE_ACTIVE_ID
  recovery_source = pRendezvous

  // Operator routes may be staged before takeoff, but not over recovery.
  // Tagged shared-drawing tasks cannot replace an airborne mission. Allow
  // TAKEOFF_OPERATIONS if rally verification arrived before the route retry.
  task_guard = UAV_FSM_OPERATION_STATE=IDLE|TAKEOFF_OPERATIONS
  operator_stage_state = IDLE
  operator_stage_state = TAKEOFF_OPERATIONS
  operator_stage_state = MISSION_EXECUTION
  recovery_stage_state = LANDING_OPERATIONS
}


//----------------------------------------------------
// pMediator sequence zero is acknowledged but intentionally not delivered.
// Consume it before the first operational UAV-to-PEARL message.
ProcessConfig = uMediatorPrime
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  paused       = false
  reset_max    = 0
  script_name  = UAV_MEDIATOR_PRIME

  event = var=NODE_MESSAGE_LOCAL, val="src_node=$(VNAME),dest_node=pearl,var_name=UAV_MEDIATOR_SYNC,string_val=true", time=0
}

//----------------------------------------------------
// Expand one repeatable cross-link CLEAR request into local route cleanup.
// All route-control consequences remain inside the vehicle community.
ProcessConfig = uRouteClear
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  condition     = ROUTE_CLEAR = true
  upon_awake    = restart
  script_atomic = true
  reset_max     = unlimited
  paused        = false
  script_name   = ROUTE_CLEAR_SEQUENCE

  event = var=UAV_TASK_CANCEL, val=true,  time=0
  event = var=ROUTE_DEPLOY,    val=false, time=0
  event = var=ROUTE_EXECUTE,   val=false, time=0
  // pRouteBuffer terminates the currently active session-named behavior.
  event = var=ROUTE_CLEAR,  val=false, time=0.75
}

//----------------------------------------------------
// Consume DEPLOY when no route is staged. This prevents a request from
// remaining armed and activating automatically when the next point arrives.
ProcessConfig = uDeployGuard
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  condition     = ROUTE_EXECUTE = true
  condition     = ROUTE_READY = false
  upon_awake    = restart
  script_atomic = true
  reset_max     = unlimited
  paused        = false
  script_name   = ROUTE_DEPLOY_GUARD

  event = var=ROUTE_EXECUTE, val=false, time=0
}

//----------------------------------------------------
ProcessConfig = pTakeoffCoordinator
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  ownship = $(VNAME)
  authority = pearl
  timeout = 100
  request_interval = 5
  completion_retry_time = 60

  result_var = TAKEOFF_REQUEST_RESULT
  state_var = TAKEOFF_REQUEST_STATE
  reason_var = TAKEOFF_REQUEST_REASON
  receipt_var = UAV_TAKEOFF_REQUEST_ID
  checks_result_var = TAKEOFF_PRECHECKS
  checks_session_var = UAV_FSM_OPERATION_STATE_TAKEOFF_OPERATIONS_EPOCH

  armed_var = UAV_IS_ARMED
  landed_var = UAV_LANDED_STATE
  arming_flag = ARM_UAV=true
  takeoff_flag = ARDU_COMMAND=DO_TAKEOFF

  request_condition = UAV_FSM_TAKEOFF_OPERATIONS_STATE=REQUESTING_TAKEOFF_CLEARANCE
  request_condition = UAV_LANDED_STATE=ON_GROUND
}

//----------------------------------------------------
// Expand each acknowledged operator request inside the vehicle community.
// Remote disarm remains available as a safety control; remote arm does not.
ProcessConfig = uOperatorDisarm
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  condition     = UAV_DISARM_REQUEST = true
  upon_awake    = restart
  script_atomic = true
  reset_max     = unlimited
  paused        = false
  script_name   = OPERATOR_DISARM

  event = var=UAV_TASK_CANCEL, val=true,  time=0
  event = var=ROUTE_DEPLOY,    val=false, time=0
  event = var=ROUTE_EXECUTE,   val=false, time=0
  event = var=MOOS_MANUAL_OVERRIDE, val=true,  time=0
  event = var=ARM_UAV,              val=false, time=0
  event = var=UAV_DISARM_REQUEST, val=false, time=0.10
}

//----------------------------------------------------


//----------------------------------------------------
// A task request owns the normal arm/takeoff/route/rendezvous sequence. Each
// stage waits for authoritative feedback from the preceding stage.


//----------------------------------------------------


//----------------------------------------------------


//----------------------------------------------------


//----------------------------------------------------


//----------------------------------------------------
// OFFNOMINAL is a terminal lifecycle outcome. Reject each new autonomous task
// request rather than leaving it latched for a future state or community event.


//----------------------------------------------------
// Compute this vehicle's own moving rendezvous point using measured motion.
// Landing clearance remains separate. Low UAV battery raises recovery
// priority instead of rejecting the aircraft that most needs to land.
ProcessConfig = pRendezvous
{
  AppTick = 4
  CommsTick = 4
  ownship = $(VNAME)
  peer_node = pearl
  nav_stale_thresh = 3
  transit_timeout = 180
  point_freeze_radius = 6
  // Fresh post-start history; positive acceleration uses 1-second speed averages.
  planning_history_window = 3
  planning_max_positive_accel = 0.5
  arrival_radius = 0.5
  arrival_dwell = 5
  point_color = yellow
  point_shape = disc
  point_radius = 0.5
  point_transparency = 0.5
  point_label = false
}

// Independent agreement/clearance; the FSM authorizes stages, not ArduPilot guidance.
ProcessConfig = pRallyPoint
{
  AppTick = 10
  CommsTick = 10
  role = vehicle
}

//----------------------------------------------------
ProcessConfig = pLandingCoordinator
{
  AppTick = 4
  CommsTick = 4
  ownship = $(VNAME)
  peer_node = pearl
  role = aircraft
  // REAL and SITL both align from the received BODY_FRD target quaternion.
  // No exposure-time NED pose or simulator-only heading is used.
  align_yaw = $(YAW_ALIGNMENT)
  yaw_tolerance = 5 // degrees; confirmed target-relative error, not an FC ACK shortcut
  yaw_rate = 30 // degrees/s; bounded relative CONDITION_YAW in the existing Guided hold
  yaw_stability_time = 0.5 // MOOS seconds of stable observations before commanding yaw
  yaw_stability_tolerance = 3 // degrees; reset stability when target orientation jumps
  yaw_hold_time = 0.5 // MOOS seconds continuously in tolerance after the command
  yaw_max_tilt = 15 // degrees combined roll/pitch; BODY_FRD yaw projection limit
  yaw_timeout = 60 // MOOS seconds; abort, never auto-retry or descend on timeout
  input_timeout = 3
  landing_timeout = 450
  rendezvous_condition = UAV_FSM_LANDING_OPERATIONS_STATE=CALCULATING_RENDEZVOUS_POINT
  command_condition = UAV_FSM_LANDING_OPERATIONS_STATE=APPROACHING
}

// Real received observations only; never draws a borrowed simulator footprint.
ProcessConfig = pLandingTargetViewer
{
  AppTick = 20
  CommsTick = 20
  target_prefix = UAV_LANDING_TARGET
  vehicle_prefix = UAV
  observation_pose_samples_var = UAV_NAV_MAVLINK_POSES
  observation_timeout = 0.5
  input_timeout = 2
  target_size = 1
  use_received_size = true
  color = magenta
}

ProcessConfig = uAirborneChecks
{
  AppTick = 4
  CommsTick = 4
  condition = UAV_FSM_TAKEOFF_OPERATIONS_STATE=TAKEOFF
  session_var = UAV_FSM_OPERATION_STATE_TAKEOFF_OPERATIONS_EPOCH
  result_var = TAKEOFF_AIRBORNE
  result_prefix = TAKEOFF_AIRBORNE_CHECK_
  check = name=NATIVE_STATE,timeout=180,max_age=3
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE_AVAILABLE,type=double,equals=1,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE,type=string,equals=IN_AIR,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE_AGE,type=double,min=0,max=2,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_IS_ARMED,type=double,equals=1,on_mismatch=wait
}

ProcessConfig = uLandingAirborneChecks
{
  AppTick = 4
  CommsTick = 4
  condition = UAV_FSM_OPERATION_STATE=LANDING_OPERATIONS
  session_var = UAV_FSM_OPERATION_STATE_LANDING_OPERATIONS_EPOCH
  result_var = LANDING_AIRBORNE_CHECKS
  result_prefix = LANDING_AIRBORNE_CHECK_
  check = name=HEALTH,timeout=10,max_age=3
  require = check=HEALTH,var=UAV_HEALTH_ALL_OK,type=double,equals=1,on_mismatch=wait
  require = check=HEALTH,var=UAV_HEALTH_AGE,type=double,min=0,max=2,on_mismatch=wait
  require = check=HEALTH,var=UAV_GPS_AVAILABLE,type=double,equals=1,on_mismatch=wait
  require = check=HEALTH,var=UAV_GPS_AGE,type=double,min=0,max=2,on_mismatch=wait
  check = name=NATIVE_STATE,timeout=180,max_age=3
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE_AVAILABLE,type=double,equals=1,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE,type=string,equals=IN_AIR,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE_AGE,type=double,min=0,max=2,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_IS_ARMED,type=double,equals=1,on_mismatch=wait
}

// Defense-in-depth FSM gate. pLandingCoordinator performs the active yaw
// transaction; this independent check only permits APPROACHING -> LANDING after
// the coordinator has confirmed fresh post-command target-relative alignment.
ProcessConfig = uLandingYawChecks
{
  AppTick = 4
  CommsTick = 4
  condition = UAV_FSM_LANDING_OPERATIONS_STATE=APPROACHING
  session_var = UAV_FSM_OPERATION_STATE_LANDING_OPERATIONS_EPOCH
  result_var = LANDING_YAW_CHECKS
  result_prefix = LANDING_YAW_CHECK_
  check = name=ALIGNMENT,timeout=70,max_age=3
#ifdef YAW_ALIGNMENT true
  require = check=ALIGNMENT,var=LANDING_OWN_YAW_STATE,type=string,equals=ALIGNED,on_mismatch=wait
#else
  // A disabled launch remains explicit and observable rather than bypassing the check.
  require = check=ALIGNMENT,var=LANDING_OWN_YAW_STATE,type=string,equals=DISABLED,on_mismatch=wait
#endif
}

ProcessConfig = uLandingGroundChecks
{
  AppTick = 4
  CommsTick = 4
  condition = UAV_FSM_OPERATION_STATE=LANDING_OPERATIONS
  session_var = UAV_FSM_OPERATION_STATE_LANDING_OPERATIONS_EPOCH
  result_var = LANDING_GROUND_CHECKS
  result_prefix = LANDING_GROUND_CHECK_
  check = name=NATIVE_STATE,timeout=180,max_age=3
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE_AVAILABLE,type=double,equals=1,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE,type=string,equals=ON_GROUND,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_LANDED_STATE_AGE,type=double,min=0,max=2,on_mismatch=wait
  require = check=NATIVE_STATE,var=UAV_IS_ARMED,type=double,equals=0,on_mismatch=wait
}

