// Passive observer for the separately routed Landmark MAVLink stream. The
// executable is launched under this alias from the SIM-only ANTLER branch.
ProcessConfig = pLandmarkBridge
{
  AppTick   = 20
  CommsTick = 20
  term_report_interval = 2

  url          = $(LANDMARK_URL)
  url_protocol = udp
  vehicle_type = copter
  vname        = $(VNAME)
  // Every telemetry family is namespaced, so the passive observer cannot
  // overwrite the SIM-owned UAV battery/GPS/health variables.
  prefix  = LANDMARK
  passive = true
  logger  = false
}

//----------------------------------------------------
ProcessConfig = uSimMarineV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  start_pos = $(START_POS=-173,-128,90)
  prefix    = NAV

  max_speed        = 5
  max_deceleration = 2

  // A multirotor can generate yaw torque at zero translational speed. Use
  // opposed virtual motor groups rather than the marine rudder model.
  thrust_mode_diff = true

  post_des_thrust = DESIRED_THRUSTX
  post_des_rudder = DESIRED_RUDDERX
}

//----------------------------------------------------
ProcessConfig = pMarinePIDV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  verbose       = false
  depth_control = false
  active_start  = true

  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.1
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder   = 100
  maxthrust   = 100
  speed_factor = 20
}

//----------------------------------------------------
// Convert the PID's forward-thrust/yaw demand into virtual left/right motor
// groups. Opposed outputs permit an in-place yaw while their average controls
// horizontal speed.
ProcessConfig = pThrustMixer
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  input_thrust_var = DESIRED_THRUST
  input_rudder_var = DESIRED_RUDDER
  output_left_var  = DESIRED_THRUST_L
  output_right_var = DESIRED_THRUST_R
  state_var        = UAV_THRUST_MIXER_STATE
  max_thrust       = 100
  max_rudder       = 100
  stale_timeout    = 1
}

//----------------------------------------------------
// Simulate telemetry following the coordinator's arming command. Landing
// resets ARM_UAV so a later task can arm again on a new command edge.
ProcessConfig = uSimArmCommand
{
  AppTick = 10
  CommsTick = 10
  term_report_interval = 2

  condition = ARM_UAV = true
  upon_awake = restart
  script_atomic = false
  reset_max = unlimited
  paused = false
  script_name = SIM_ARM_COMMAND

  event = var=UAV_IS_ARMED,   val=1, time=0
  event = var=AUTOPILOT_MODE, val=SIM_ARMED, time=0
}

//----------------------------------------------------
// SIM translates the coordinator's ARDU_COMMAND into telemetry and attachment
// feedback. REAL pArduBridge consumes the same command directly.
ProcessConfig = uSimTakeoffCommand
{
  AppTick = 10
  CommsTick = 10
  term_report_interval = 2

  condition = ARDU_COMMAND = DO_TAKEOFF
  condition = UAV_IS_ARMED = 1
  upon_awake = restart
  script_atomic = false
  reset_max = unlimited
  paused = false
  script_name = SIM_TAKEOFF_COMMAND

  event = var=SIM_ATTACHMENT_REQUEST, val=false, time=0
  event = var=UAV_LANDED_STATE,       val=TAKING_OFF, time=0
  // uTimerScript evaluates the braced arithmetic after nsplug substitutes the
  // target, so every SIM takeoff altitude follows the configured target.
  event = var=STATION_KEEP,           val=false, time=0.1
  // 25 equal increments over 2.5 seconds (nominally one per 10 Hz tick).
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.04}, time=0.1
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.08}, time=0.2
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.12}, time=0.3
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.16}, time=0.4
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.20}, time=0.5
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.24}, time=0.6
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.28}, time=0.7
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.32}, time=0.8
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.36}, time=0.9
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.40}, time=1.0
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.44}, time=1.1
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.48}, time=1.2
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.52}, time=1.3
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.56}, time=1.4
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.60}, time=1.5
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.64}, time=1.6
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.68}, time=1.7
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.72}, time=1.8
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.76}, time=1.9
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.80}, time=2.0
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.84}, time=2.1
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.88}, time=2.2
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.92}, time=2.3
  event = var=NAV_ALTITUDE,           val={$(TAKEOFF_ALTITUDE)*0.96}, time=2.4
  event = var=NAV_ALTITUDE,           val=$(TAKEOFF_ALTITUDE), time=2.5
  event = var=UAV_LANDED_STATE,       val=IN_AIR, time=2.5
  event = var=AUTOPILOT_MODE,         val=SIM_HOLD, time=2.5
  event = var=UAV_COMMAND_RESULT,     val="id=sim,command=TAKEOFF,status=COMPLETED,detail=TARGET_ALTITUDE_REACHED", time=2.5
}

//----------------------------------------------------
// Match the REAL route handoff: stage via ROUTE_EXECUTE, then release the
// Helm route only after it is ready and airborne. SIM has no pArduBridge, so
// HELM_STATUS and FLY_WAYPOINT are intentionally not posted here.
ProcessConfig = uRouteSequence
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  condition     = ROUTE_EXECUTE = true
  condition     = ((ROUTE_EXECUTE_PURPOSE = operator) and (UAV_FSM_OPERATION_STATE = MISSION_EXECUTION)) or ((ROUTE_EXECUTE_PURPOSE = recovery) and (UAV_FSM_OPERATION_STATE = LANDING_OPERATIONS))
  condition     = ROUTE_READY = true
  condition     = UAV_IS_ARMED = 1
  condition     = UAV_LANDED_STATE = IN_AIR
  upon_awake    = restart
  script_atomic = false
  reset_max     = unlimited
  paused        = false
  script_name   = SIM_ROUTE_SEQUENCE
  status_var    = ROUTE_SEQUENCE_STATUS

  event = var=ROUTE_DEPLOY,  val=true,  time=0.20
  event = var=ROUTE_EXECUTE, val=false, time=0.90
}

//----------------------------------------------------
ProcessConfig = uSimPrecLandCommand
{
  AppTick = 10
  CommsTick = 10
  term_report_interval = 2

  condition = ARDU_COMMAND = AUTOLAND
  upon_awake = restart
  script_atomic = false
  reset_max = unlimited
  paused = false
  script_name = SIM_PREC_LAND_COMMAND

  event = var=STATION_KEEP,           val=false, time=0
  event = var=NAV_ALTITUDE,           val=0, time=0
  event = var=UAV_LANDED_STATE,       val=ON_GROUND, time=0
  event = var=UAV_IS_ARMED,           val=0, time=0
  event = var=ARM_UAV,                val=false, time=0
  event = var=AUTOPILOT_MODE,         val=SIM_LANDED, time=0
  event = var=UAV_COMMAND_RESULT,     val="id=sim,command=LAND,status=COMPLETED,detail=SIMULATED", time=0
}

//----------------------------------------------------
// Reattach only after a nominal precision landing has returned the companion
// FSM to Idle on deck. Secondary/rally landing terminates in OFFNOMINAL, so it
// deliberately leaves the UAV simulator detached from PEARL.
ProcessConfig = uSimAttachmentCommand
{
  AppTick = 10
  CommsTick = 10
  term_report_interval = 2

  condition = NAV_ALTITUDE = 0
  condition = UAV_FSM_OPERATION_STATE = IDLE
  upon_awake = restart
  script_atomic = false
  reset_max = unlimited
  paused = false
  script_name = SIM_ATTACHMENT_COMMAND

  event = var=SIM_ATTACHMENT_REQUEST, val=true, time=0
}

//----------------------------------------------------
ProcessConfig = uSimUavBattery
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  paused     = false
  reset_max  = unlimited
  reset_time = 1
  script_name = SIM_UAV_BATTERY

  event = var=UAV_BATTERY_SOC,         val=80,   time=0
  event = var=UAV_BATTERY_DATA_VALID,  val=1,    time=0
  event = var=UAV_HEALTH_ALL_OK,       val=1,    time=0
  event = var=UAV_HEALTH_AVAILABLE,    val=1,    time=0
  event = var=UAV_HEALTH_AGE,          val=0,    time=0
  event = var=UAV_IS_ARMABLE,          val=1,    time=0
  event = var=UAV_GPS_AVAILABLE,       val=1,    time=0
  event = var=UAV_GPS_FIX_TYPE,        val=3,    time=0
  event = var=UAV_GPS_SATELLITES,      val=10,   time=0
  event = var=UAV_GPS_AGE,             val=0,    time=0
}

// Initialize simulated armed/landed feedback once. Subsequent operator
// scripts own state changes; never periodically force an armed UAV disarmed.
ProcessConfig = uSimUavInitialArmed
{
  AppTick = 4
  CommsTick = 4
  paused = false
  reset_max = 1
  script_name = SIM_UAV_INITIAL_ARMED

  event = var=UAV_IS_ARMED,     val=0,         time=0
  event = var=UAV_LANDED_STATE, val=ON_GROUND, time=0
}

// Refresh SIM telemetry while attached, grounded, and disarmed through both
// readiness and request-session checks; stop when the arm feedback arrives.
ProcessConfig = uSimUavGroundTelemetry
{
  AppTick = 4
  CommsTick = 4
  condition = SIM_ATTACHMENT_ATTACHED = 1
  condition = (UAV_FSM_TAKEOFF_OPERATIONS_STATE = ESTABLISHING_TAKEOFF_READINESS) or (UAV_FSM_TAKEOFF_OPERATIONS_STATE = REQUESTING_TAKEOFF_CLEARANCE)
  condition = UAV_IS_ARMED = 0
  condition = UAV_LANDED_STATE = ON_GROUND
  upon_awake = restart
  script_atomic = false
  paused = false
  reset_max = unlimited
  reset_time = 1
  script_name = SIM_UAV_GROUND_TELEMETRY

  event = var=UAV_IS_ARMED,        val=0,         time=0
  event = var=UAV_LANDED_STATE,    val=ON_GROUND, time=0
  event = var=UAV_LANDED_STATE_AGE,val=0,         time=0
}

ProcessConfig = uSimAttachment
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  input_max_age      = 2
  initially_attached = true
}
