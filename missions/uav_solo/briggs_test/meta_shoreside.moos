//-------------------------------------------------
// FILE: meta_shoreside.moos
// NAME: Charles Benjamin
//-------------------------------------------------

// All processes in this community use the local MOOSDB. IP_ADDR is reserved
// for the externally advertised pShare address in pHostInfo below.
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = shoreside

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = uLoadWatch      @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = uFldNodeComms   @ NewConsole = false
  Run = pMediator       @ NewConsole = false
  Run = pRouteBuffer    @ NewConsole = false
#ifdef LAUNCH_GUI yes
  Run = moos-vnc-session   @ NewConsole = false ~pMarineViewer
#endif
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1

#ifdef LAUNCH_GUI yes
  thresh = app=pMarineViewer, gapthresh=5
#endif
  thresh = app=uFldNodeComms, gapthresh=4
  thresh = app=pHostInfo,     gapthresh=5
  thresh = app=any,           gapthresh=2.0

  breach_trigger = 5
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1

  // Pin the broker-advertised address to --ip. This prevents automatic
  // interface discovery from selecting Wi-Fi, Ethernet, or Tailscale.
  default_hostip_force = $(IP_ADDR=localhost)
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_SHORESIDE
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//----------------------------------------------------
ProcessConfig = pMediator
{
  AppTick   = 4
  CommsTick = 4

  vname         = shoreside
  mates         = briggs
  resend_thresh = 1
  max_tries     = 10
}

//----------------------------------------------------
ProcessConfig = pRouteBuffer
{
  AppTick   = 4
  CommsTick = 4

  role             = shoreside
  source_node      = shoreside
  destination_node = briggs
  max_points       = 50
}

//----------------------------------------------------
ProcessConfig = uFldShoreBroker
{
  AppTick   = 4
  CommsTick = 4

  auto_bridge_appcast = true
  auto_bridge_realmcast = false

  bridge = src=MEDIATED_MESSAGE_LOCAL, alias=MEDIATED_MESSAGE
  bridge = src=ACK_MESSAGE_LOCAL, alias=ACK_MESSAGE

#ifdef XMODE SIM
#else
  qbridge = HEARTBEAT
#endif
  qbridge = NODE_REPORT
}

//----------------------------------------------------
ProcessConfig = uFldNodeComms
{
  AppTick   = 2
  CommsTick = 2

  comms_range      = 1000
  critical_range   = 25
  min_msg_interval = 1
  max_msg_length   = 1000
  groups           = true

  view_node_rpt_pulses = false
}

//----------------------------------------------------
ProcessConfig = pMarineViewer
{
  AppTick   = 4
  CommsTick = 4

  beat_flag = HEARTBEAT_ALL=true

  tiff_file          = ../../images/briggs_test/briggs_test.tif
  set_pan_x          = 0
  set_pan_y          = 0
  zoom               = 1.0
  vehicle_shape_scale = 1.25
  vehicles_name_mode  = names+mode

  appcast_viewable     = true
  appcast_height       = 70
  appcast_width        = 35
  appcast_color_scheme = indigo
  appcast_font_size    = large
  procs_font_size      = large
  nodes_font_size      = large

  stale_report_thresh = 10
  stale_remove_thresh = 30

  scope = NAV_ALTITUDE
  scope = UAV_IS_ARMED
  scope = UAV_LANDED_STATE
  scope = UAV_COMMAND_RESULT
  scope = UAV_LANDING_TARGET_AVAILABLE
  scope = UAV_LANDING_TARGET_AGE
  scope = AUTOPILOT_MODE
  scope = CONTROL_AUTHORITY
  scope = IVPHELM_STATE
  scope = ROUTE_DEPLOY
  scope = ROUTE_READY
  scope = ROUTE_CLEAR
  scope = STATION_KEEP
  scope = ROUTE_UPDATE
  scope = DESIRED_HEADING
  scope = DESIRED_SPEED
  scope = DESIRED_ALTITUDE
  scope = PROC_WATCH_SUMMARY
  scope = PROC_WATCH_ALL_OK
  scope = VEHICLE_PROC_WATCH_ALL_OK
  scope = ROUTE_BUFFER_STATE
  scope = ROUTE_BUFFER_COUNT
  scope = ROUTE_BUFFER_VEHICLE_STATE

  left_context[route] = ROUTE_POINT = "x=$[XPOS],y=$[YPOS]"

  // Each operator action crosses the link as one acknowledged pMediator
  // message. The vehicle expands the request into mode-specific local posts.
  button_1 = ARM # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=$(VNAMES),var_name=UAV_ARM_REQUEST,string_val=true"
  button_2 = DISARM # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=$(VNAMES),var_name=UAV_DISARM_REQUEST,string_val=true" # color=red
  button_3 = TAKEOFF # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=$(VNAMES),var_name=UAV_TAKEOFF_REQUEST,string_val=true"
  button_4 = DEPLOY # ROUTE_BUFFER_DEPLOY=true
  button_5 = CLEAR # ROUTE_BUFFER_CLEAR=true
  button_6 = PREC LAND # NODE_MESSAGE_LOCAL="src_node=shoreside,dest_node=$(VNAMES),var_name=UAV_PREC_LAND_REQUEST,string_val=true" # color=orange
}
