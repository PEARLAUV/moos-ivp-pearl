//-------------------------------------------------
// FILE: meta_shoreside.moos
// NAME: Charles Benjamin
//-------------------------------------------------

// All processes in this community use the local MOOSDB. IP_ADDR is reserved
// for the externally advertised pShare address in pHostInfo below.
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = shoreside

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = uLoadWatch      @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = uFldNodeComms   @ NewConsole = false
#ifdef LAUNCH_GUI yes
  Run = moos-vnc-session @ NewConsole=false ~ pMarineViewer
  // Run = pMarineViewer   @ NewConsole = false
#endif
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1

  thresh = app=pMarineViewer, gapthresh=5
  thresh = app=uFldNodeComms, gapthresh=4
  thresh = app=pHostInfo,     gapthresh=5
  thresh = app=any,           gapthresh=2.0

  breach_trigger = 5
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1

  default_hostip_force = $(IP_ADDR)
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_SHORESIDE
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//----------------------------------------------------
ProcessConfig = uFldShoreBroker
{
  AppTick   = 1
  CommsTick = 1

  auto_bridge_appcast = true

#ifdef XMODE SIM
  qbridge = DEPLOY, STATION_KEEP, PRECISION_LOITER, LEG_REQUEST
  qbridge = MOOS_MANUAL_OVERRIDE, LEG_MODE, GO
#else
  qbridge = ARDU_COMMAND, ARM_UAV, HELM_STATUS, NEXT_WAYPOINT, LEG_REQUEST
  qbridge = MOOS_MANUAL_OVERRIDE
#endif
  qbridge = NODE_REPORT, NODE_MESSAGE
}

//----------------------------------------------------
ProcessConfig = uFldNodeComms
{
  AppTick   = 2
  CommsTick = 2

  comms_range      = 1000
  critical_range   = 25
  min_msg_interval = 1
  max_msg_length   = 1000
  groups           = true

  view_node_rpt_pulses = false
}

//----------------------------------------------------
ProcessConfig = pMarineViewer
{
  AppTick   = 4
  CommsTick = 4

  tiff_file          = ../../images/B33_Test/B33_Test.tif
  set_pan_x          = 0
  set_pan_y          = 0
  zoom               = 1.0
  vehicle_shape_scale = 1.0
  vehicles_name_mode  = names+mode

  appcast_viewable     = true
  appcast_height       = 70
  appcast_width        = 35
  appcast_color_scheme = indigo
  appcast_font_size    = large
  procs_font_size      = large
  nodes_font_size      = large

  stale_report_thresh = 10
  stale_remove_thresh = 30

  scope = NAV_ALTITUDE
  scope = UAV_IS_ARMED
  scope = UAV_LANDED_STATE
  scope = UAV_COMMAND_RESULT
  scope = UAV_LANDING_TARGET_AVAILABLE
  scope = UAV_LANDING_TARGET_AGE
  scope = AUTOPILOT_MODE
  scope = IVPHELM_STATE
  scope = TOWAYPT_UPDATE
  scope = DESIRED_HEADING
  scope = DESIRED_SPEED
  scope = DESIRED_ALTITUDE
  scope = PROC_WATCH_SUMMARY
  scope = PROC_WATCH_ALL_OK

#ifdef XMODE SIM
  button_1 = ARM # UAV_IS_ARMED=true # AUTOPILOT_MODE=SIM_ARMED # UAV_COMMAND_RESULT=id=sim,command=ARM,status=ACCEPTED,detail=SIMULATED
  button_2 = DISARM # DEPLOY_ALL=false # GO_ALL=false # PRECISION_LOITER_ALL=false # MOOS_MANUAL_OVERRIDE_ALL=true # UAV_IS_ARMED=false # UAV_LANDED_STATE=ON_GROUND # NAV_ALTITUDE=0 # AUTOPILOT_MODE=SIM_DISARMED # UAV_COMMAND_RESULT=id=sim,command=DISARM,status=ACCEPTED,detail=SIMULATED # color=red
  button_3 = TAKEOFF # DEPLOY_ALL=true # GO_ALL=false # STATION_KEEP_ALL=true # PRECISION_LOITER_ALL=false # MOOS_MANUAL_OVERRIDE_ALL=false # UAV_LANDED_STATE=IN_AIR # NAV_ALTITUDE=8 # AUTOPILOT_MODE=SIM_HOLD # UAV_COMMAND_RESULT=id=sim,command=TAKEOFF,status=COMPLETED,detail=TARGET_ALTITUDE_REACHED

  button_4 = LEG 1 # LEG_MODE_ALL=LEG1 # LEG_REQUEST_ALL=LEG1 # DEPLOY_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_GUIDED
  button_5 = LEG 2 # LEG_MODE_ALL=LEG2 # LEG_REQUEST_ALL=LEG2 # DEPLOY_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_GUIDED
  button_6 = LEG 3 # LEG_MODE_ALL=LEG3 # LEG_REQUEST_ALL=LEG3 # DEPLOY_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_GUIDED
  button_7 = HOME # LEG_MODE_ALL=HOME # LEG_REQUEST_ALL=HOME # DEPLOY_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_RETURN

  button_8  = FC LOITER # DEPLOY_ALL=true # GO_ALL=false # STATION_KEEP_ALL=true # PRECISION_LOITER_ALL=false # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_LOITER
  button_9  = PREC LOITER # DEPLOY_ALL=true # GO_ALL=false # STATION_KEEP_ALL=true # PRECISION_LOITER_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_PRECISION_LOITER # UAV_COMMAND_RESULT=id=sim,command=PRECISION_LOITER,status=CONFIRMED,detail=MOOS_STATION_KEEP
  button_10 = PREC OFF # GO_ALL=true # STATION_KEEP_ALL=false # PRECISION_LOITER_ALL=false # AUTOPILOT_MODE=SIM_GUIDED
  button_11 = PREC LAND # DEPLOY_ALL=false # GO_ALL=false # STATION_KEEP_ALL=false # PRECISION_LOITER_ALL=false # MOOS_MANUAL_OVERRIDE_ALL=true # NAV_ALTITUDE=0 # UAV_LANDED_STATE=ON_GROUND # UAV_IS_ARMED=false # AUTOPILOT_MODE=SIM_LANDED # UAV_COMMAND_RESULT=id=sim,command=LAND,status=COMPLETED,detail=SIMULATED # color=orange
  button_12 = VIZ HOME # VIEW_POINT=x=0,y=0,label=home,vertex_color=yellow,vertex_size=10,active=true
  button_13 = RETURN HOME # LEG_MODE_ALL=HOME # LEG_REQUEST_ALL=RETURN # DEPLOY_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false # AUTOPILOT_MODE=SIM_RETURN # color=yellow
#else
  button_1 = ARM # ARM_UAV_ALL=true
  button_2 = DISARM # ARM_UAV_ALL=false # color=red
  button_3 = TAKEOFF # ARDU_COMMAND_ALL=DO_TAKEOFF

  button_4 = LEG 1 # NEXT_WAYPOINT_ALL=lat=$(LEG1_LAT),lon=$(LEG1_LON),x=35,y=20,vname=all # LEG_REQUEST_ALL=LEG1
  button_5 = LEG 2 # NEXT_WAYPOINT_ALL=lat=$(LEG2_LAT),lon=$(LEG2_LON),x=65,y=55,vname=all # LEG_REQUEST_ALL=LEG2
  button_6 = LEG 3 # NEXT_WAYPOINT_ALL=lat=$(LEG3_LAT),lon=$(LEG3_LON),x=20,y=65,vname=all # LEG_REQUEST_ALL=LEG3
  button_7 = HOME # NEXT_WAYPOINT_ALL=lat=$(HOME_LAT),lon=$(HOME_LON),x=0,y=0,vname=all # LEG_REQUEST_ALL=HOME

  button_8  = FC LOITER # ARDU_COMMAND_ALL=LOITER_FC
  button_9  = PREC LOITER # ARDU_COMMAND_ALL=PRECISION_LOITER
  button_10 = PREC OFF # ARDU_COMMAND_ALL=PRECISION_LOITER_OFF
  button_11 = PREC LAND # ARDU_COMMAND_ALL=AUTOLAND # color=orange
  button_12 = VIZ HOME # ARDU_COMMAND_ALL=VIZ_HOME
  button_13 = RTL (FC) # MOOS_MANUAL_OVERRIDE_ALL=true # color=yellow
#endif
}
